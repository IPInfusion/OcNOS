        uses global-grouping;
    }

    augment /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf {
        if-feature feature-list:HAVE_VRF;
        description
            "VRF Static Route configurations";
        uses static-routes-grouping;
    }

    augment /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf {
        if-feature feature-list:HAVE_VRF;
        description
            "RIB run-time attributes";
        uses ribs-grouping;
    }

    augment /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf {
    when " /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-network-instance:instance-type = 'vrf' and /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf/ipi-vrf:config/ipi-vrf:vrf-name != 'default' and /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf/ipi-vrf:config/ipi-vrf:vrf-name != 'management' ";
        if-feature feature-list:HAVE_VRF;
        description
            "VRF Max Route configurations";
        uses maximum-fib-routes-grouping;
    }


    rpc clear-ip-vrf-route-all {
        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_RIBD;
        description "Use clear-ip-vrf-route-all to clear all IPv4 VRF routes of any
                    particular VRF name";
        input  {
            leaf vrf-name  {
                type string;
                mandatory true;
                description "vrf name";
            }
        }
    }

    rpc clear-ip-vrf-route {
        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_RIBD;
        description "Use clear-ip-vrf-route to clear any specific prefix IPv4 VRF route of
                    any particular VRF name";
        input  {
            leaf vrf-name  {
                type string;
                mandatory true;
                description "vrf name";
            }
            leaf prefix-address  {
                type cml-data-types:cml_ipv4_prefix_t;
                mandatory true;
                description "Prefix to be cleared(e.g. 10.0.0.0/8)";
            }
        }
    }

    rpc clear-ipv6-vrf-route-all {
        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_IPV6;
        if-feature feature-list:HAVE_RIBD;
        description "Use clear-ipv6-vrf-route-all to clear all IPv6 VRF routes of any
                    particular VRF name";
        input  {
            leaf vrf-name  {
                type string;
                mandatory true;
                description "vrf name";
            }
        }
    }

    rpc clear-ipv6-vrf-route {
        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_IPV6;
        if-feature feature-list:HAVE_RIBD;
        description "Use clear-ipv6-vrf-route to clear any specific prefix IPv6 VRF route
                    of any particular VRF name";
        input  {
            leaf vrf-name  {
                type string;
                mandatory true;
                description "Virtual router id";
            }
            leaf prefix-ipv6-address  {
                type cml-data-types:cml_ipv6_prefix_t;
                mandatory true;
                description "Prefix to be cleared(e.g. 3ffe:506::/32)";
            }
        }
    }

    notification vrf-ipv4-fib-routes-above-threshold {
        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_RIBD;

        description "Notify when the installed VRF FIB IPv4 routes crosses the configured threshold.";

        leaf severity {
            type cml-data-types:cml_notif_severity_t;
            description "Notification severity level (value: WARNING)";
        }

        leaf eventClass {
            type cml-data-types:cml_notif_class_t;
            description "Notification event class (value: STATE)";
        }

        leaf instance-type {
            type ipi-network-instance-types:net_inst_type_t;
        description
            "Network Instance Type";
        }

        leaf instance-name {
            type  string;
        description
            "Network Instance Name.
                    For VRF and MAC VRF, instance name can be up to 32 chars long.
                    For VPWS and VPLS instances, instance name can be up to 128 chars
                    long.
                    For L2NI (bridge) instance, instance name has to be a number between
                    (1-32).
                    For Cross-Connect, instance name can be up to 30 chars long.
                    For Bridge-domain, instance, instance name has to be a number between
                    (1-2147483647).";
        }

        leaf max-limit {
            type  uint32;
        description
            "Use this attribute to limit the maximum number of routes to be
                    installed in VRF FIB.";
        }

        leaf warning-threshold {
            type  uint8;
        description
            "Use this attribute to define a percentage of the maximum route limit
                    which when crossed results in a warning message and Netconf
                    notification being raised. Default is 80%.";
        }

        leaf threshold-exceeded {
            type  boolean;
        description
            "This attribute indicates whether the max route threshold is exceeded
                    or not.";
        }

        leaf total-routes {
            type  yang:counter32;
        description
            "Total routes in the RIB from all protocols";
        }
    }

