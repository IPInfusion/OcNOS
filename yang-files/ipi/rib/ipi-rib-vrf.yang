        if-feature feature-list:HAVE_VRF;
        if-feature feature-list:HAVE_RIBD;
        description
            "VRF Max Route configurations";
        container ipv4 {
            description
                "IPV4 Max Route configurations";
            container config {
                presence "To configure max IPv4 fib routes";
                description
                    "Configuration attributes for IPv4 max routes";
                uses maximum-fib-route-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational data for IPv4 max routes";
                uses maximum-fib-route-config;
                uses maximum-fib-route-state;
            } // END of state-container definition.
        } // END of ipv4-container definition.
        container ipv6 {
            if-feature feature-list:HAVE_IPV6;
            description
                "IPV6 Max Route configurations";
            container config {
                presence "To configure max IPv6 fib routes";
                description
                    "Configuration attributes for IPv6 max routes";
                uses maximum-fib-route-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational data for IPv6 max routes";
                uses maximum-fib-route-config;
                uses maximum-fib-route-state;
            } // END of state-container definition.
        } // END of ipv6-container definition.
    } // END of maximum-fib-routes-container definition.
    } // END of maximum-fib-routes-grouping definition.

    augment /ipi-network-instance:network-instances/ipi-network-instance:network-instance/ipi-vrf:vrf {
        if-feature feature-list:HAVE_VRF;
        description
