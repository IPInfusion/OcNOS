    rpc clear-default-router-id {
        if-feature feature-list:HAVE_L3;
        if-feature feature-list:HAVE_VRF;
        description "Use this RPC to update default VRF router ID for all routing processes
                    in the System";
    }

    rpc clear-vrf-router-id {
