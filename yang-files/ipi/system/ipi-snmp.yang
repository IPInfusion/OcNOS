    grouping snmp-server-trap-config {
        description
            "Grouping for snmp-server trap config objects.";
        leaf enable-traps  {
            type  ipi-snmp-types:snmp_trap_protocols;
            description "Use this attribute to enable or disable SNMP traps and inform
                        requests.";
        } // END of enable-traps definition.

        leaf enable-link-down-trap  {
            type  boolean;
            description "Use this attribute to enable or disable SNMP linkdown traps.";
        } // END of enable-link-down-trap definition.

        leaf enable-link-up-trap  {
            type  boolean;
            description "Use this attribute to enable or disable SNMP linkup traps.";
        } // END of enable-link-up-trap definition.

        leaf include-interface-name  {
            type  empty;
            description "Use this attribute to include ifname with SNMP linkdown traps.";
        } // END of include-interface-name definition.

    } // END of snmp-server-trap-config definition.
    grouping snmp-server-trap-cache-config {
        description
            "Group for SNMP trap caching configuration";
        leaf enable-trap-cache  {
            if-feature feature-list:HAVE_SNMP_AGENT;
            type  empty;
            mandatory true;
            description "Enables trap caching";
        } // END of enable-trap-cache definition.

        leaf timeout  {
            type  int8 {
                 range "1..20"  {
                    description "1..20: Supported range 1 - 20";
                 }
            }
            units "minutes";
            default "10";
            description "Sets timeout before sending traps";
        } // END of timeout definition.

        leaf disable-ping  {
            type  empty;
            description "Disables pings to check host reachability";
        } // END of disable-ping definition.

        leaf max-count  {
            type  int16 {
                 range "1..500"  {
                    description "1..500: Supported range 1 - 500";
                 }
            }
            default "200";
            description "Sets the maximum number of traps that can be cached";
        } // END of max-count definition.

    } // END of snmp-server-trap-cache-config definition.
    grouping snmp-server-trap-cache-top {
        description
            "SNMP server trap cache configuration";
        container trap-cache {
            description
                "SNMP server default container configuration";
            container config {
                presence "trap-cache";
                description
                    "Configuration data for SNMP server trap cache configuration";
                uses snmp-server-trap-cache-config;
            } // END of config-container definition.
            container state {
                config false;
                description
