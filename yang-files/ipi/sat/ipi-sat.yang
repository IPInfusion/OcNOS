    } // END of sat-rate-profile-config definition.
    grouping sat-rate-profile-top {
        description
            "Grouping for SAT rate profile top grouping";
        container rate-profiles {
            description
                "Container for SAT rate profile";

            list rate-profile {
                key "rate-pname";
                description
                    "Lis of SAT rate profile";
                leaf rate-pname  {
                    type  leafref {
                        path  "../config/rate-pname";
                    }
                    description "SAT profile name";
                } // END of rate-pname definition.

                container config {
                    description
                        "Configuration data for SAT profile";
                    uses sat-rate-profile-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT profile";
                    uses sat-rate-profile-config;
                } // END of state-container definition.
                uses sat-commited-information-rate-top;
                uses sat-excess-information-rate-top;
                uses sat-delay-bins-top;
            } // End of rate-profile-list
        } // END of rate-profiles-container definition.
    } // END of sat-rate-profile-top definition.
    grouping sat-acceptance-profile-config {
        description
            "Grouping for SAT acceptance Profile Configuration data";
        leaf acceptance-pname  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "SAT profile name";
        } // END of acceptance-pname definition.

        leaf cir-frame-loss-ratio  {
            type  string {
                length "1..1965";
                pattern "([0-9][.][0-9]{4})|([1-9][0][.][0-9]{4})|([1-9]{2}[.][0-9]{4})|([1][0][0][.][0]{4})";
            }
            description "Specify the cir frame loss ratio";
        } // END of cir-frame-loss-ratio definition.

        leaf cir-frame-loss-ratio-policing  {
            type  string {
                length "1..1965";
                pattern "([0-9][.][0-9]{4})|([1-9][0][.][0-9]{4})|([1-9]{2}[.][0-9]{4})|([1][0][0][.][0]{4})";
            }
            description "Specifiy cir frame loss ratio policing";
        } // END of cir-frame-loss-ratio-policing definition.

        leaf cir-frame-delay-variation  {
            // when " ../cir-frame-delay-variation-range ";
            type  ipi-sat-types:sat_delay_rate_t;
            description "Specify the cir frame delay variation";
        } // END of cir-frame-delay-variation definition.

        leaf cir-frame-delay-variation-range  {
            // when " ../cir-frame-delay-variation ";
            type  uint16 {
                 range "1..10000"  {
                    description "1..10000: Supported range 1 - 10000";
                 }
            }
            description "Specify the cir frame delay variation range";
        } // END of cir-frame-delay-variation-range definition.

        leaf cir-frame-delay  {
            // when " ../cir-frame-delay-range ";
            type  ipi-sat-types:sat_delay_rate_t;
            description "Specify the cir frame delay variation";
        } // END of cir-frame-delay definition.

        leaf cir-frame-delay-range  {
            // when " ../cir-frame-delay ";
            type  uint16 {
                 range "1..10000"  {
                    description "1..10000: Supported range 1 - 10000";
                 }
            }
            description "specify the cir frame delay variation range";
        } // END of cir-frame-delay-range definition.

    } // END of sat-acceptance-profile-config definition.
    grouping sat-acceptance-profile-top {
        description
            "Top level grouping for SAT acceptance profile";
        container acceptance-profiles {
            description
                "Container for SAT acceptance profile";

            list acceptance-profile {
                key "acceptance-pname";
                description
                    "Lis of SAT acceptance profile";
                leaf acceptance-pname  {
                    type  leafref {
                        path  "../config/acceptance-pname";
                    }
                    description "SAT acceptance profile name";
                } // END of acceptance-pname definition.

                container config {
                    description
                        "Configuration data for SAT profile";
                    uses sat-acceptance-profile-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT profile";
                    uses sat-acceptance-profile-config;
                } // END of state-container definition.
            } // End of acceptance-profile-list
        } // END of acceptance-profiles-container definition.
    } // END of sat-acceptance-profile-top definition.
    grouping sat-frame-size-profile-config {
        description
            "Grouping for SAT frame size Profile Configuration data";
        leaf size-pname  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "SAT profile name";
        } // END of size-pname definition.

        leaf size-a  {
            type  empty;
            description "Specify the size a frame size as 64";
        } // END of size-a definition.

        leaf size-b  {
            type  empty;
            description "Specify the size b frame size as 128";
        } // END of size-b definition.

        leaf size-c  {
            type  empty;
            description "Specify the size c frame size as 256";
        } // END of size-c definition.

        leaf size-d  {
            type  empty;
            description "Specify the size d frame size as 512";
        } // END of size-d definition.

        leaf size-e  {
            type  empty;
            description "Specify the size e frame size as 1024";
        } // END of size-e definition.

        leaf size-f  {
            type  empty;
            description "Specify the size f frame size as 1280";
        } // END of size-f definition.

        leaf size-g  {
            type  empty;
            description "Specify the size g frame size as 64";
        } // END of size-g definition.

        leaf size-h  {
            type  uint16 {
                 range "60..9200"  {
                    description "60..9200: Supported range 60 - 9200";
                 }
            }
            description "Specify the size h frame size as 64";
        } // END of size-h definition.

        leaf size-u  {
            type  uint16 {
                 range "60..9200"  {
                    description "60..9200: Supported range 60 - 9200";
                 }
            }
            description "Specify the size u frame size as 64";
        } // END of size-u definition.

    } // END of sat-frame-size-profile-config definition.
    grouping sat-frame-size-profile-top {
        description
            "Top level grouping for SAT frame size profile";
        container frame-size-profiles {
            description
                "Container for SAT frame size profile";

            list frame-size-profile {
                key "size-pname";
                description
                    "Lis of SAT frame size profile";
                leaf size-pname  {
                    type  leafref {
                        path  "../config/size-pname";
                    }
                    description "SAT frame size profile name";
                } // END of size-pname definition.

                container config {
                    description
                        "Configuration data for SAT profile";
                    uses sat-frame-size-profile-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT profile";
                    uses sat-frame-size-profile-config;
                } // END of state-container definition.
            } // End of frame-size-profile-list
        } // END of frame-size-profiles-container definition.
    } // END of sat-frame-size-profile-top definition.
    grouping service-test-config {
        description
            "Grouping or service test config";
        leaf test-type  {
            type  ipi-sat-types:sat_service_t;
            description "test-type";
        } // END of test-type definition.

        leaf duration  {
            type  empty;
            description "Used to set duration";
        } // END of duration definition.

        leaf hours  {
            // when " ../duration ";
            type  uint8 {
                 range "1..60"  {
                    description "1..60: Supported range 1 - 60";
                 }
            }
            description "Set the time in terms of hours";
        } // END of hours definition.

        leaf minutes  {
            // when " ../duration ";
            type  uint8 {
                 range "1..60"  {
                    description "1..60: Supported range 1 - 60";
                 }
            }
            description "Set the time in terms of minutes";
        } // END of minutes definition.

        leaf seconds  {
            // when " ../duration ";
            type  uint8 {
                 range "1..60"  {
                    description "1..60: Supported range 1 - 60";
                 }
            }
            description "Set the time in terms of seconds";
        } // END of seconds definition.

    } // END of service-test-config definition.
    grouping sat-frame-payload-config {
        description
            "Grouping for SAT frame payload configuration data";
        leaf frame-payload  {
            type  empty;
            mandatory true;
            description "Specify frame payload";
        } // END of frame-payload definition.

        leaf dst-mac  {
            type  ipi-sat-types:sat_mac_addr_t {
                length "1..1965";
            }
            description "Specify the destination MAC address";
        } // END of dst-mac definition.

        leaf source-interface  {
            type  leafref {
                path  "/ipi-interface:interfaces/ipi-interface:interface/ipi-interface:name";
            }
            description "Specify the source interface name";
        } // END of source-interface definition.

        leaf tag-type  {
            type  ipi-sat-types:sat_tag_type_t;
            description "This attribute is used to configure the tag type (dot1q|dot1ad).";
        } // END of tag-type definition.

        leaf vlan-id  {
            // when " ../tag-type ";
            type  uint16 {
                 range "1..4095"  {
                    description "1..4095: Supported range 1 - 4095";
                 }
            }
            description "The VID monitored by this MA";
        } // END of vlan-id definition.

        leaf inner-vlan-id  {
            // when " ../tag-type ";
            type  uint16 {
                 range "1..4094"  {
                    description "1..4094: Supported range 1 - 4094";
                 }
            }
            description "The inner VLAN ID monitored by this MA";
        } // END of inner-vlan-id definition.

    } // END of sat-frame-payload-config definition.
    grouping sat-cfm-config {
        description
            "Grouping for SAT CFM configuration";
        leaf domain-name  {
            type  string {
                length "1..32";
                pattern "[^?' =,>|]+";
            }
            mandatory true;
            description "Specify the CFM domain name";
        } // END of domain-name definition.

        leaf ma-name  {
            type  string {
                length "1..32";
                pattern "[^?' =,>|]+";
            }
            mandatory true;
            description "Specify the MA name";
        } // END of ma-name definition.

        leaf mep-id  {
            type  uint16 {
                 range "1..8191"  {
                    description "1..8191: Supported range 1 - 8191";
                 }
            }
            mandatory true;
            description "Use this attribute to set the MEP id";
        } // END of mep-id definition.

    } // END of sat-cfm-config definition.
    grouping sat-cfm-top {
        description
            "Top level grouping for SAT CFM configuration";
        container cfm {
            description
                "Container for SAT CFM configuration";
            container config {
                presence "yes";
                description
                    "Configuration data for SAT CFM";
                uses sat-cfm-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "SAT CFM Operational state data";
                uses sat-cfm-config;
            } // END of state-container definition.
        } // END of cfm-container definition.
    } // END of sat-cfm-top definition.
    grouping sat-frame-payload-top {
        description
            "Top level grouping for SAT frame payload";
        container frame-payload {
            description
                "Container for SAT frame payload configuration";
            container config {
                presence "frame payload";
                description
                    "Configuration data for frame-payload";
                uses sat-frame-payload-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "SAT frame payload Operational state data";
                uses sat-frame-payload-config;
            } // END of state-container definition.
            uses sat-cfm-top;
        } // END of frame-payload-container definition.
    } // END of sat-frame-payload-top definition.
    grouping sat-stream-config {
        description
            "Grouping for SAT stream Configuration data";
        leaf stream-name  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "SAT profile name";
        } // END of stream-name definition.

        leaf description  {
            type  cml-data-types:cml_line_t {
                length "1..255";
            }
            description "Used to set the description";
        } // END of description definition.

        leaf rate-profile  {
            type  leafref {
                path  "/sat/rate-profiles/rate-profile/config/rate-pname";
            }
            description "Specify the rate profile";
        } // END of rate-profile definition.

        leaf acceptance-profile  {
            type  leafref {
                path  "/sat/acceptance-profiles/acceptance-profile/config/acceptance-pname";
            }
            description "Specify the acceptance profile name";
        } // END of acceptance-profile definition.

        leaf frame-size-profile  {
            type  leafref {
                path  "/sat/frame-size-profiles/frame-size-profile/config/size-pname";
            }
            description "Specify the frame size profile name";
        } // END of frame-size-profile definition.

        leaf frame-sequence  {
            type  string {
                length "1..32";
                pattern "[a-hu]{1,9}";
            }
            description "Specify the frame sequence";
        } // END of frame-sequence definition.

        leaf frame-data-pattern  {
            type  ipi-sat-types:sat_data_pattern_t;
            description "Specify the frame data pattern";
        } // END of frame-data-pattern definition.

        leaf frame-delay-disable  {
            type  empty;
            description "Use this attribute to disable frame delay";
        } // END of frame-delay-disable definition.

    } // END of sat-stream-config definition.
    grouping sat-service-stream-top {
        description
            "Top level grouping for SAT service stream";
        container streams {
            description
                "Container for SAT service streams";

            list stream {
                key "stream-name";
                description
                    "Lis of SAT service stream";
                leaf stream-name  {
                    type  leafref {
                        path  "../config/stream-name";
                    }
                    description "SAT test";
                } // END of stream-name definition.

                container config {
                    description
                        "Configuration data for SAT service stream";
                    uses sat-stream-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT service stream";
                    uses sat-stream-config;
                } // END of state-container definition.
                uses sat-frame-payload-top;
            } // End of stream-list
        } // END of streams-container definition.
    } // END of sat-service-stream-top definition.
    grouping sat-service-test-top {
        description
            "Top level grouping for SAT service test";
        container service-tests {
            description
                "Container for SAT service tests";

            list service-test {
                key "test-type";
                description
                    "Lis of SAT service test";
                leaf test-type  {
                    type  leafref {
                        path  "../config/test-type";
                    }
                    description "SAT test";
                } // END of test-type definition.

                container config {
                    description
                        "Configuration data for SAT service test";
                    uses service-test-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT service test";
                    uses service-test-config;
                } // END of state-container definition.
            } // End of service-test-list
        } // END of service-tests-container definition.
    } // END of sat-service-test-top definition.
    grouping sat-test-config {
        description
            "Grouping for SAT test Configuration data";
        leaf test-name  {
            type  string {
                length "1..32";
                pattern "[^?' =,>|]+";
            }
            description "SAT profile name";
        } // END of test-name definition.

        leaf description  {
            type  cml-data-types:cml_line_t {
                length "1..255";
            }
            description "Used to set the description";
        } // END of description definition.

        leaf direction  {
            type  ipi-sat-types:sat_direction_t;
            description "Used to map the direction as upstream/downstream";
        } // END of direction definition.

        leaf stream-run  {
            type  ipi-sat-types:sat_stream_run_t;
            description "Used to set the stream run";
        } // END of stream-run definition.

    } // END of sat-test-config definition.
    grouping sat-test-top {
        description
            "Tpp level grouping for SAT test";
        container tests {
            description
                "Container for SAT test configuration";

            list test {
                key "test-name";
                description
                    "Lis of SAT test configuration";
                leaf test-name  {
                    type  leafref {
                        path  "../config/test-name";
                    }
                    description "SAT test";
                } // END of test-name definition.

                container config {
                    description
                        "Configuration data for SAT test";
                    uses sat-test-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for SAT test";
                    uses sat-test-config;
                } // END of state-container definition.
                uses sat-service-test-top;
                uses sat-service-stream-top;
                uses sat-test-state-top;
                uses sat-test-summary-top;
            } // End of test-list
        } // END of tests-container definition.
    } // END of sat-test-top definition.
    grouping sat-interface-config {
        description
            "Grouping for SAT module config objects";
        leaf interface-name  {
            type  leafref {
                path  "/ipi-interface:interfaces/ipi-interface:interface/ipi-interface:name";
            }
            description "This attribute describes the textual name of the interface";
        } // END of interface-name definition.

        leaf data-loopback  {
            type  ipi-sat-types:sat_direction_t;
            description "Use this attribute to set the ethernet data loopback for
                        upstream/downstream";
        } // END of data-loopback definition.

    } // END of sat-interface-config definition.
    grouping sat-interface-top {
        description
            "Grouping for SAT interface configuration";
        container interfaces {
            description
                "container for interface level configuration for SAT";

            list interface {
                key "interface-name";
                description
                    "List of SAT interface related operations";
                leaf interface-name  {
                    type  leafref {
                        path  "../config/interface-name";
                    }
                    description "Use this attribute to perform platform's interface SAT related
                                configurations";
                } // END of interface-name definition.

                container config {
                    description
                        "configuration container for interface list";
                    uses sat-interface-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational data for interface";
                    uses sat-interface-config;
                } // END of state-container definition.
            } // End of interface-list
        } // END of interfaces-container definition.
    } // END of sat-interface-top definition.

    grouping  sat-grouping {
    description
        "Container for SAT (Service Activation Test)";
    container sat {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description
            "Container for SAT (Service Activation Test)";
        uses sat-rate-profile-top;
        uses sat-acceptance-profile-top;
        uses sat-frame-size-profile-top;
        uses sat-test-top;
        uses sat-interface-top;
    } // END of sat-container definition.
    } // END of sat-grouping definition.

    uses sat-grouping;

    rpc service-activation-test-start {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description "start a servoce activation test";
        input  {
            leaf test-name  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "This attribute specify the  SAT test name";
            }
            leaf sat-unit  {
                type ipi-sat-types:sat_service_t;
                mandatory true;
                description "Specify the SAT unit";
            }
            leaf service-stream  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "Specify the service stream name";
            }
            leaf repeat-last-fail-test  {
                type ipi-sat-types:sat_repeat_last_fail_test_t;
                mandatory true;
                description "Repeat from the Last failed test case for SAT";
            }
        }
    }

    rpc service-activation-test-abort {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description "start a service activation test";
        input  {
            leaf test-name  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "This attribute specify the  SAT test name";
            }
            leaf sat-unit  {
                type ipi-sat-types:sat_service_t;
                mandatory true;
                description "Specify the SAT UNIT";
            }
            leaf service-stream  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "Specify the service stream name";
            }
        }
    }

    rpc service-activation-test-clear {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description "start a service activation test";
        input  {
            leaf test-name  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "This attribute specify the  SAT test name";
            }
            leaf sat-unit  {
                type ipi-sat-types:sat_service_t;
                mandatory true;
                description "This attribute specify sat test unit";
            }
            leaf service-stream  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "Specify the service stream name";
            }
        }
    }

    rpc data-loopback-start {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description "start a data loopback";
        input  {
            leaf interface-name  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "This attribute specify the interface name";
            }
            leaf timeout  {
                type uint16 {
                    range "0..1440";
                }
                mandatory true;
                description "This attribute specify the time out";
            }
        }
    }

    rpc data-loopback-abort {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;
        description "abort a data loopback";
        input  {
            leaf interface-name  {
                type string {
                    length "1..32";
                }
                mandatory true;
                description "This attribute specify the interface name";
            }
            leaf timeout  {
                type uint16 {
                    range "0..1440";
                }
                mandatory true;
                description "This attribute specify the time";
            }
        }
    }

    notification sat-tests-results-completed {
        if-feature feature-list:HAVE_CFM;
        if-feature feature-list:HAVE_ONMD;
        if-feature feature-list:HAVE_ETH_SAT;

        description "Notify that the result is completed.";

        leaf severity {
            type cml-data-types:cml_notif_severity_t;
            description "Notification severity level (value: INFO)";
        }

        leaf eventClass {
            type cml-data-types:cml_notif_class_t;
            description "Notification event class (value: STATE)";
        }

        leaf run {
            type  uint8;
        description
            "This attribute specifies run for summary";
        }

        leaf test-name {
            type  string;
        description
            "SAT test";
        }

        leaf status {
            type ipi-sat-types:sat_summary_status;
        description
            "This attribute specifies status of run";
        }
    }

}