    typedef  platform_bgp_flowspec_mode_t {
        type enumeration {
            enum install-all {
                value 1;
                description "FLOWSPEC rules are prioritized. The all rules already installed are reinstalled when a new rule is tried to add.";
            }
            enum install-partial {
                value 2;
                description "FLOWSPEC rules are prioritized. Install not all rules already installed if possible to avoid unnecessarily reinstalling rules.";
            }
            enum no-prioritizing {
                value 3;
                description "FLOWSPEC rules are not prioritized. Install only rules requested to add but not reinstall any other rules when a new rule is tried to add.";
            }
        }
        description "type definition for PLATFORM_BGP_FLOWSPEC_MODE_T";
    }

