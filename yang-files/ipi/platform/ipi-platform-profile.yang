            description "Use this attribute to enable or disable Ingress Mirror filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of ingress-mirror definition.

    } // END of hardware-profile-filters-config definition.
    grouping hardware-profile-filter-evpn-mpls-multi-homing {
        description
            "Grouping for hardware profile filter evpn mpls multi-homing.";
        leaf evpn-mpls-multi-homing  {
            if-feature feature-list:HAVE_NVO;
            if-feature feature-list:HAVE_MPLS;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable EVPN-MPLS Multi Homing
                        Forwarding filter groups. Disabling filter groups increases the
                        configurable filter entries.";
        } // END of evpn-mpls-multi-homing definition.

    } // END of hardware-profile-filter-evpn-mpls-multi-homing definition.
    grouping platform-advanced-parser-soc-enable {
        description
            "Grouping for hw SOC property config objects.";
        leaf parser-enable  {
            if-feature feature-list:HAVE_MPLS;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set parser enable";
        } // END of parser-enable definition.

        leaf parser-nibble-map  {
            if-feature feature-list:HAVE_MPLS;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  ipi-platform-profile-types:platform_parser_type_t;
            description "This Object is to set speculation option";
        } // END of parser-nibble-map definition.

    } // END of platform-advanced-parser-soc-enable definition.
    grouping hardware-profiles-statistics-config {
        description
            "Grouping for hardware-profile statistics config objects.";
        leaf voq-scale  {
            if-feature feature-list:HAVE_DNX;
            type  ipi-platform-profile-types:platform_voq_scale_type_t;
            default "full";
            description "Use this attribute to set voq scale for the hardware profile
                        statistics";
        } // END of voq-scale definition.

        leaf virtual-output-queue-full-color-forward-drop  {
            if-feature feature-list:HAVE_DNX;
            type  ipi-platform-profile-types:cml_voq_full_color_fwd_drop_t;
            default "voq-full-color";
            description "Use this attribute to enable  Virtual Output Queue Forward Drop or
                        Virtual Output Queue Full Color filter groups. Disabling filter groups
                        increases the configurable filter entries.";
        } // END of virtual-output-queue-full-color-forward-drop definition.

        leaf ingress-acl  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  ipi-platform-profile-types:platform_ing_acl_stat;
            description "Use this attribute to enable or disable Ingress ACL QoS and PBR filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of ingress-acl definition.

        leaf egress-acl  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Egress ACL filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-acl definition.

        leaf egress-policer  {
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Egress policer filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-policer definition.

        leaf ingress-qos  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable explicitly for QoS filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of ingress-qos definition.

        leaf attachment-circuit-logical-if  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable attachment circuits logical
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of attachment-circuit-logical-if definition.

        leaf tunnel-logical-if  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable tunnel logical filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of tunnel-logical-if definition.

        leaf evpn-mpls-stats  {
            if-feature feature-list:HAVE_NVO;
            if-feature feature-list:HAVE_MPLS;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable hardware statistics for
                        evpn-mpls.";
        } // END of evpn-mpls-stats definition.

        leaf mpls-pseudowire  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:HAVE_MPLS_STATS;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable MPLS Pseudowire filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of mpls-pseudowire definition.

        leaf cfm-frame-loss-measurements  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:HAVE_CFM;
            type  empty;
            description "Use this attribute to enable or disable CFM Loss Measurements filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of cfm-frame-loss-measurements definition.

        leaf cfm-synthetic-loss-measurements  {
            if-feature feature-list:HAVE_DNX;
            if-feature feature-list:HAVE_CFM;
            type  empty;
            description "Use this attribute to enable or disable CFM Loss Measurements filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of cfm-synthetic-loss-measurements definition.

        leaf cfm-continuity-check-messages  {
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:CCM_HW_OFFLOAD;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable CFM Continuity Check Messages
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of cfm-continuity-check-messages definition.

        leaf cfm-continuity-check-message  {
            if-feature feature-list:HAVE_DNX;
            if-feature feature-list:CCM_HW_OFFLOAD;
            type  cml-data-types:cml_enable_disable_t;
            description "Use this attribute to enable or disable CFM Continuity Check Messages
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of cfm-continuity-check-message definition.

        leaf virtual-output-queue-full-color  {
            // when " !ipi-platform-profile:profiles/hardware-profile/statistics/config/virtual-output-queue-forward-drop ";
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Virtual Output Queue Full
                        Color filter groups. Disabling filter groups increases the
                        configurable filter entries.";
        } // END of virtual-output-queue-full-color definition.

        leaf virtual-output-queue-forward-drop  {
            // when " !ipi-platform-profile:profiles/hardware-profile/statistics/config/virtual-output-queue-full-color ";
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Virtual Output Queue Forward
                        Drop filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of virtual-output-queue-forward-drop definition.

    } // END of hardware-profiles-statistics-config definition.
    grouping hardware-tcam-state {
        description
            "Grouping for hardware tcam state objects.";
        leaf warning-threshold-level  {
            type  int32;
            description "Warning TCAM threshold level in percentage. Value of -1 means the
                        field is not applicable.";
        } // END of warning-threshold-level definition.

        leaf critical-alert-threshold-level  {
            type  int32;
            description "Alert TCAM threshold level in percentage. Value of -1 means the field
                        is not applicable.";
        } // END of critical-alert-threshold-level definition.

    } // END of hardware-tcam-state definition.
    grouping hardware-tcam-filter-group-state {
        description
            "Grouping for hardware tcam filter group state objects.";
        leaf group-id  {
            type  uint32;
            description "A unique number corresponding to each TCAM group. This attribute is
                        used solely for defining the key for the TCAM utilization filter
                        groups object list. It's value shouldn't be interpreted.";
        } // END of group-id definition.

        leaf group-name  {
            type  cml-data-types:cml_line_t {
                length "1..1965";
            }
            description "TCAM Utilization filter group name.";
        } // END of group-name definition.

        leaf free-entries  {
            type  int32;
            description "Count of free entries in the TCAM group. Value of -1 means the field
                        is not applicable.";
        } // END of free-entries definition.

        leaf used-entries  {
            type  int32;
            description "Percentage of entries used in the TCAM group.Value of -1 means the
                        field is not applicable.";
        } // END of used-entries definition.

        leaf used-percentage  {
            type  int32;
            description "Percentage of entries used in the TCAM group. Value of -1 means the
                        field is not applicable.";
        } // END of used-percentage definition.

        leaf total-entries  {
            type  int32;
            description "Count of total entries in the TCAM group.Total is summation of
                        dedicated entries and shared entries.Value of -1 means the field is
                        not applicable.";
        } // END of total-entries definition.

        leaf dedicated-entries  {
            type  int32;
            description "Count of total entries dedicated to TCAM group. Dedicated entries are
                        fixed to the TCAM group and are the minimum guaranteed number. Value
                        of -1 means the field is not applicable.";
        } // END of dedicated-entries definition.

        leaf shared-entries  {
            type  int32;
            description "Count of entries which are shared across TCAM groups. Value of -1
                        means the field is not applicable.";
        } // END of shared-entries definition.

    } // END of hardware-tcam-filter-group-state definition.
    grouping hardware-unit-state {
        description
            "State information for each hardware unit/core.";
        leaf unit  {
            type  uint32;
            description "Unit ID";
        } // END of unit definition.

        leaf core  {
            type  uint32;
            description "Core ID";
        } // END of core definition.

    } // END of hardware-unit-state definition.
    grouping hardware-tcam-filter-top {
        description
            "Grouping for hardware tcam filter";
        container tcam-utilization {
            if-feature feature-list:HAVE_ACL;
            config false;
            description
                "This container defines TCAM Utilization information.";
            container state {
                config false;
                description
                    "This container defines TCAM Utilization information Operational
                            states.";
                uses hardware-tcam-state;
            } // END of state-container definition.
            uses hardware-filter-group;
        } // END of tcam-utilization-container definition.
    } // END of hardware-tcam-filter-top definition.
    grouping hardware-tcam-filter-platform-top {
        description
            "Grouping for hardware tcam filter";
        container tcam-utilization {
            if-feature feature-list:HAVE_ACL;
            config false;
            description
                "This container defines TCAM Utilization information.";
            container state {
                config false;
                description
                    "This container defines TCAM Utilization information Operational
                            states.";
                uses hardware-tcam-state;
            } // END of state-container definition.
            container hardware-units {
                config false;
                description
                    "This container defines per-unit/core TCAM data.";

                list hardware-unit {
                    key "unit core";
                    config false;
                    description
                        "List of hardware units and cores";
                    leaf unit  {
                        type  leafref {
                            path  "../state/unit";
                        }
                        description "Unit ID";
                    } // END of unit definition.

                    leaf core  {
                        type  leafref {
                            path  "../state/core";
                        }
                        description "Core ID";
                    } // END of core definition.

                    container state {
                        config false;
                        description
                            "Operational states per hardware unit/core.";
                        uses hardware-unit-state;
                    } // END of state-container definition.
                    uses hardware-filter-group;
                } // End of hardware-unit-list
            } // END of hardware-units-container definition.
        } // END of tcam-utilization-container definition.
    } // END of hardware-tcam-filter-platform-top definition.
    grouping hardware-filter-group {
        description
            "grouping for TCAM Utilization filter-groups.";
        container filter-groups {
            config false;
            description
                "This container defines TCAM Utilization filter-groups information.";

            list filter-group {
                key "group-id";
                config false;
                description
                    "The list of named filter-group.";
                leaf group-id  {
                    type  leafref {
                        path  "../state/group-id";
                    }
                    description "A unique number corresponding to each TCAM group. This attribute is
                                used solely for defining the key for the TCAM utilization filter
                                groups object list. It's value shouldn't be interpreted.";
                } // END of group-id definition.

                container state {
                    config false;
                    description
                        "This container defines filter-group information Operational states.";
                    uses hardware-tcam-filter-group-state;
                } // END of state-container definition.
            } // End of filter-group-list
        } // END of filter-groups-container definition.
    } // END of hardware-filter-group definition.
    grouping platform-kaps-config {
        description
            "Grouping for forwarding-profiles kaps config objects.";
        leaf profile-type  {
            type  ipi-platform-profile-types:platform_kaps_profile_type_t;
            description "forwarding profile for KAPS";
        } // END of profile-type definition.

    } // END of platform-kaps-config definition.
    grouping platform-ext-tcam-config {
        description
            "Grouping for forwarding-profiles external-tcam config objects.";
        leaf profile-type  {
            type  ipi-platform-profile-types:platform_ext_tcam_profile_type_t;
            default "profile-one";
            description "forwarding profile for external TCAM";
        } // END of profile-type definition.

    } // END of platform-ext-tcam-config definition.
    grouping platform-custom-tcam-config {
        description
            "Grouping for forwarding-profiles external-tcam config objects.";
        leaf profile-type  {
            type  ipi-platform-profile-types:platform_tcam_custom_profile_t;
            mandatory true;
            description "forwarding profile for type for custom-TCAM";
        } // END of profile-type definition.

        leaf ipv4-percentage  {
            type  uint8 {
                 range "10..90"  {
                    description "10..90: Supported range 10 - 90";
                 }
            }
            units "%";
            mandatory true;
            description "Use this attribute to set Percentage of entries for ipv4 routes";
        } // END of ipv4-percentage definition.

        leaf ipv6-percentage  {
            type  uint8 {
                 range "10..90"  {
                    description "10..90: Supported range 10 - 90";
                 }
            }
            units "%";
            mandatory true;
            description "Use this attribute to set Percentage of entries for ipv6 routes";
        } // END of ipv6-percentage definition.

    } // END of platform-custom-tcam-config definition.
    grouping platform-kaps-state {
        description
            "Grouping for KAPS Forwarding Profile state objects.";
        leaf profile  {
            type  ipi-platform-profile-types:platform_kaps_forwading_profile_t;
            description "Profile type";
        } // END of profile definition.

        leaf is-active  {
            type  boolean;
            description "Active in hardware";
        } // END of is-active definition.

        leaf public-db-size  {
            type  uint32;
            description "Public-db size";
        } // END of public-db-size definition.

        leaf private-db-size  {
            type  uint32;
            description "Private-db size";
        } // END of private-db-size definition.

    } // END of platform-kaps-state definition.
    grouping platform-elk-tcam-state {
        description
            "Grouping for External TCAM Forwarding Profile state objects.";
        leaf profile  {
            type  ipi-platform-profile-types:platform_elk_tcam_forwading_profile_t;
            description "Profile type";
        } // END of profile definition.

        leaf is-active  {
            type  boolean;
            description "Active in hardware";
        } // END of is-active definition.

        leaf ipv4-db-size  {
            type  uint32;
            description "IPv4 DB size";
        } // END of ipv4-db-size definition.

        leaf ipv6-db-size  {
            type  uint32;
            description "IPv6 DB size";
        } // END of ipv6-db-size definition.

    } // END of platform-elk-tcam-state definition.
    grouping platform-rate-limit-config {
        description
            "Grouping for cpu-queue rate-limit config objects.";
        leaf queue-name  {
            type  ipi-platform-profile-types:platform_cpu_queue_name_t;
            description "This attribute specifies CPU queue name for rate limiting config";
        } // END of queue-name definition.

        leaf rate  {
            type  int32 {
                 range "0..100000"  {
                    description "0..100000:Feature : HAVE_DUNE Supported range 0 - 100000Not Feature :
                            HAVE_DUNE  Supported range 0 - 100000";
                 }
            }
            description "CPU queue Rate";
        } // END of rate definition.

        leaf monitor-status  {
            if-feature feature-list:HAVE_DUNE;
            type  ipi-platform-profile-types:platform_cpu_queue_monitor_t;
            description "monitor cpu queue usage";
        } // END of monitor-status definition.

    } // END of platform-rate-limit-config definition.
    grouping platform-load-balance-config {
        description
            "Grouping for load-balance config objects.";
        leaf enable  {
            type  empty;
            mandatory true;
            description "This Object is set loadBalance";
        } // END of enable definition.

        leaf mpls-label-based  {
            type  empty;
            description "This Object is set for load balancing based on mpls labels";
        } // END of mpls-label-based definition.

        leaf mpls-inner-stack  {
            // when " ipi-platform-profile:hardware/hw-soc-property/config/parser-enable ";
            if-feature feature-list:HAVE_MPLS;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  ipi-platform-profile-types:platform_load_balance_mpls_inner_stack_t;
            description "This Object is set for Source IPV4 based load balancing";
        } // END of mpls-inner-stack definition.

        leaf rtag7-all-lag-if  {
            if-feature feature-list:NOT_HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable RTAG7 on every aggregator interface";
        } // END of rtag7-all-lag-if definition.

        leaf multi-level-ecmp  {
            // when " ipi-platform-profile:hardware/load-balance/config/enable ";
            if-feature feature-list:HAVE_L3;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable multi level ECMP load
                        balancing";
        } // END of multi-level-ecmp definition.

        leaf trunk-hash-offset  {
            // when " ipi-platform-profile:hardware/load-balance/config/enable ";
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  uint8 {
                 range "0..15"  {
                    description "0..15: Supported range 0 - 15";
                 }
            }
            description "Set trunk hash offset (valid range: 0-15)";
        } // END of trunk-hash-offset definition.

        leaf ecmp-hash-offset  {
            // when " ipi-platform-profile:hardware/load-balance/config/enable ";
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  uint8 {
                 range "0..15"  {
                    description "0..15: Supported range 0 - 15";
                 }
            }
            description "Set ecmp hash offset (valid range: 0-15)";
        } // END of ecmp-hash-offset definition.

        leaf hash-seed  {
            // when " ipi-platform-profile:hardware/load-balance/config/enable ";
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  uint16 {
                 range "1..65535"  {
                    description "1..65535: Supported range 1 - 65535";
                 }
            }
            description "Set hash seed (valid range: 1-65535)";
        } // END of hash-seed definition.

    } // END of platform-load-balance-config definition.
    grouping platform-load-balance-l2-config {
        description
            "Grouping for load-balance l2 config objects.";
        leaf dest-mac-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Destination Mac address based load balancing";
        } // END of dest-mac-based definition.

        leaf src-mac-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Source Mac address based load balancing";
        } // END of src-mac-based definition.

        leaf ether-type-based  {
            type  empty;
            description "This Object is set for Ether-type based load balancing";
        } // END of ether-type-based definition.

        leaf vlan-based  {
            type  empty;
            description "This Object is set for Vlan based load balancing";
        } // END of vlan-based definition.

    } // END of platform-load-balance-l2-config definition.
    grouping platform-load-balance-ipv4-config {
        description
            "Grouping for load-balance ipv4 config objects.";
        leaf src-ipv4-address-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Source IPV4 based load balancing";
        } // END of src-ipv4-address-based definition.

        leaf dest-ipv4-address-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Destination IPV4 based load balancing";
        } // END of dest-ipv4-address-based definition.

        leaf src-l4-port-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Source L4 port based load balancing";
        } // END of src-l4-port-based definition.

        leaf dest-l4-port-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Destination L4 port based load balancing";
        } // END of dest-l4-port-based definition.

        leaf protocol-id-based  {
            type  empty;
            description "This Object is set for Protocol Id based load balancing";
        } // END of protocol-id-based definition.

        leaf rocev2-dest-qpairs  {
            if-feature feature-list:NOT_HAVE_DUNE;
            type  empty;
            description "This Object is set for qpairs based load balancing on ROCE";
        } // END of rocev2-dest-qpairs definition.

    } // END of platform-load-balance-ipv4-config definition.
    grouping platform-load-balance-flb-base-config {
        description
            "Grouping for load-balance flb config objects.";
        leaf enable  {
            type  empty;
            mandatory true;
            description "This Object is set loadBalance";
        } // END of enable definition.

    } // END of platform-load-balance-flb-base-config definition.
    grouping platform-cpu-queue-top {
        description
            "Grouping for platform cpu-queue objects.";
        container cpu-queue {
            if-feature feature-list:HAVE_BROADCOM_OR_HAVE_MARVELL;
            description
                "This container defines cpu-queue configuration and state information.";
            container rate-limits {
                description
                    "This container defines rate-limits configuration and state
                            information.";

                list rate-limit {
                    key "queue-name";
                    description
                        "The list of rate-limit configuration.";
                    leaf queue-name  {
                        type  leafref {
                            path  "../config/queue-name";
                        }
                        description "This attribute specifies CPU queue name for rate limiting config";
                    } // END of queue-name definition.

                    container config {
                        description
                            "This container defines cpu-queue rate-limit configuration.";
                        uses platform-rate-limit-config;
                        uses platform-extended-rate-limit-config;
                    } // END of config-container definition.
                    container state {
                        config false;
                        description
                            "This container defines cpu-queue rate-limit information Operational
                                    states.";
                        uses platform-rate-limit-config;
                        uses platform-extended-rate-limit-config;
                    } // END of state-container definition.
                } // End of rate-limit-list
            } // END of rate-limits-container definition.
        } // END of cpu-queue-container definition.
    } // END of platform-cpu-queue-top definition.
    grouping platform-load-balance-ipv6-config {
        description
            "Grouping for load-balance ipv6 config objects.";
        leaf src-ipv6-address-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Source IPV6 based load balancing";
        } // END of src-ipv6-address-based definition.

        leaf dest-ipv6-address-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Destination IPV6 based load balancing";
        } // END of dest-ipv6-address-based definition.

        leaf src-l4-port-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Source L4 port based load balancing";
        } // END of src-l4-port-based definition.

        leaf dest-l4-port-based  {
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "This Object is set for Destination L4 port based load balancing";
        } // END of dest-l4-port-based definition.

        leaf next-header-based  {
            type  empty;
            description "This Object is set for Next Header Field for IPV6";
        } // END of next-header-based definition.

        leaf rocev2-dest-qpairs  {
            if-feature feature-list:NOT_HAVE_DUNE;
            type  empty;
            description "This Object is set for qpairs based load balancing on ROCE";
        } // END of rocev2-dest-qpairs definition.

    } // END of platform-load-balance-ipv6-config definition.
    grouping mvl-platform-load-balance-config {
        description
            "Marvell Grouping for load-balance config objects.";
        leaf enable  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            mandatory true;
            description "This Object is set loadBalance";
        } // END of enable definition.

        leaf mpls-label-based  {
            if-feature feature-list:HAVE_MARVELL;
            if-feature feature-list:HAVE_MPLS;
            type  empty;
            description "This Object is set for load balancing based on mpls labels";
        } // END of mpls-label-based definition.

    } // END of mvl-platform-load-balance-config definition.
    grouping mvl-platform-load-balance-l2-config {
        description
            "Marvell Grouping for load-balance l2 config objects.";
        leaf dest-mac-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Destination Mac address based load balancing";
        } // END of dest-mac-based definition.

        leaf src-mac-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Source Mac address based load balancing";
        } // END of src-mac-based definition.

        leaf ether-type-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Ether-type based load balancing";
        } // END of ether-type-based definition.

        leaf vlan-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Vlan based load balancing";
        } // END of vlan-based definition.

        leaf ing-intf-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Source Physical Port based load balancing";
        } // END of ing-intf-based definition.

    } // END of mvl-platform-load-balance-l2-config definition.
    grouping mvl-platform-load-balance-ipv4-config {
        description
            "Marvell Grouping for load-balance ipv4 config objects.";
        leaf src-ipv4-address-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Source IPV4 based load balancing";
        } // END of src-ipv4-address-based definition.

        leaf dest-ipv4-address-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Destination IPV4 based load balancing";
        } // END of dest-ipv4-address-based definition.

        leaf src-l4-port-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Source L4 port based load balancing";
        } // END of src-l4-port-based definition.

        leaf dest-l4-port-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "This Object is set for Destination L4 port based load balancing";
        } // END of dest-l4-port-based definition.

        leaf protocol-id-based  {
            type  empty;
            description "This Object is set for Protocol Id based load balancing";
        } // END of protocol-id-based definition.

    } // END of mvl-platform-load-balance-ipv4-config definition.
    grouping mvl-platform-load-balance-ipv6-config {
        description
            "Marvell Grouping for load-balance ipv6 config objects.";
        leaf flow-label-based  {
            if-feature feature-list:HAVE_MARVELL;
            type  empty;
            description "Flowlabel based load balancing";
        } // END of flow-label-based definition.

        leaf src-ipv6-address-based  {
            type  empty;
            description "This Object is set for Source IPV6 based load balancing";
        } // END of src-ipv6-address-based definition.

        leaf dest-ipv6-address-based  {
            type  empty;
            description "This Object is set for Destination IPV6 based load balancing";
        } // END of dest-ipv6-address-based definition.

        leaf src-l4-port-based  {
            type  empty;
            description "This Object is set for Source L4 port based load balancing";
        } // END of src-l4-port-based definition.

        leaf dest-l4-port-based  {
            type  empty;
            description "This Object is set for Destination L4 port based load balancing";
        } // END of dest-l4-port-based definition.

        leaf next-header-based  {
            type  empty;
            description "This Object is set for Next Header Field for IPV6";
        } // END of next-header-based definition.

    } // END of mvl-platform-load-balance-ipv6-config definition.

    grouping  forwarding-profile-route-modes-grouping {
    description
        "This container defines forwarding-profiles-route-modes configuration
                and state information";
    container forwarding-profile-route-modes {
        if-feature feature-list:HAVE_BROADCOM;
        if-feature feature-list:HAVE_CMMD;
        if-feature feature-list:HAVE_BROADCOM_OR_HAVE_MARVELL;
        description
            "This container defines forwarding-profiles-route-modes configuration
                    and state information";
        container config {
            if-feature feature-list:HAVE_BCM_UFT;
            if-feature feature-list:NOT_HAVE_DUNE;
            description
                "This container defines forwarding-profiles-route-modes configuration.";
            uses platform-extended-forwarding-profile-route-modes-config;
        } // END of config-container definition.
        container state {
            if-feature feature-list:HAVE_BCM_UFT;
            if-feature feature-list:NOT_HAVE_DUNE;
            config false;
            description
                "This container defines forwarding-profile-route-modes operational
                        states.";
            uses platform-extended-forwarding-profile-route-modes-config;
        } // END of state-container definition.
    } // END of forwarding-profile-route-modes-container definition.
    } // END of forwarding-profile-route-modes-grouping definition.

    grouping  profiles-grouping {
    description
        "Top level container for platform profiles, including configuration and
                state data";
    container profiles {
        if-feature feature-list:HAVE_BROADCOM;
        if-feature feature-list:HAVE_CMMD;
        if-feature feature-list:HAVE_BROADCOM_OR_HAVE_MARVELL;
        description
            "Top level container for platform profiles, including configuration and
                    state data";
        container hardware-profile {
            description
                "This container defines hardware-profile configuration and state
                        information.";
            container config {
                description
                    "This container defines hardware-profile configuration.";
                uses hardware-profile-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "This container defines hardware-profile Operational states.";
                uses hardware-profile-config;
            } // END of state-container definition.
            container filters {
                description
                    "This container defines hardware-profile filter configuration and state
                            information.";
                container config {
                    description
                        "This container defines hardware-profile filter configuration.";
                    uses hardware-profile-filters-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines hardware-profile filter Operational states.";
                    uses hardware-profile-filters-config;
                } // END of state-container definition.
                uses hardware-tcam-filter-platform-top;
            } // END of filters-container definition.
            container filter-evpn-mpls-mh {
                description
                    "This container defined hardware profile-filter evpn-mpls-mh
                            configuration and state information.";
                container config {
                    description
                        "This container defines hardware-profile filter evpn-mpls-mh
                                configuration";
                    uses hardware-profile-filter-evpn-mpls-multi-homing;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines hardware-profile filter evpn-mpls-mh
                                Operational states";
                    uses hardware-profile-filter-evpn-mpls-multi-homing;
                } // END of state-container definition.
                uses hardware-tcam-filter-top;
            } // END of filter-evpn-mpls-mh-container definition.
            container statistics {
                description
                    "This container defines hardware-profile statistics configuration and
                            state information.";
                container config {
                    description
                        "This container defines hardware-profile statistics configuration.";
                    uses hardware-profiles-statistics-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines hardware-profile statistics Operational states.";
                    uses hardware-profiles-statistics-config;
                } // END of state-container definition.
            } // END of statistics-container definition.
            uses hardware-l2vpn-instances-limits-grouping;
        } // END of hardware-profile-container definition.
        container forwarding-profiles {
            description
                "This container defines forwarding-profiles configuration and state
                        information.";
            container config {
                if-feature feature-list:HAVE_BCM_UFT;
                if-feature feature-list:NOT_HAVE_DUNE;
                description
                    "This container defines forwarding-profiles configuration.";
                uses platform-extended-forwarding-profile-config;
            } // END of config-container definition.
            container state {
                if-feature feature-list:HAVE_BCM_UFT;
                if-feature feature-list:NOT_HAVE_DUNE;
                config false;
                description
                    "This container defines forwarding-profiles operational states.";
                uses platform-extended-forwarding-profile-config;
            } // END of state-container definition.
            container kaps {
                if-feature feature-list:HAVE_DUNE;
                if-feature feature-list:HAVE_BCM_UFT;
                if-feature feature-list:NOT_HAVE_DNX;
                description
                    "This container defines forwarding-profiles KAPS configuration and
                            state information.";
                container config {
                    description
                        "This container defines forwarding-profiles KAPS configuration.";
                    uses platform-kaps-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container definesforwarding-profiles KAPS Operational states.";
                    uses platform-kaps-config;
                } // END of state-container definition.
            } // END of kaps-container definition.
            container external-tcam {
                if-feature feature-list:HAVE_DUNE;
                if-feature feature-list:HAVE_BCM_UFT;
                if-feature feature-list:NOT_HAVE_DNX;
                description
                    "This container defines forwarding-profiles external-TCAM configuration
                            and state information.";
                container config {
                    description
                        "This container defines forwarding-profiles external-TCAM
                                configuration.";
                    uses platform-ext-tcam-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container definesforwarding-profiles external-TCAM Operational
                                states.";
                    uses platform-ext-tcam-config;
                } // END of state-container definition.
            } // END of external-tcam-container definition.
            container custom-tcam {
                if-feature feature-list:HAVE_DUNE;
                if-feature feature-list:HAVE_BCM_UFT;
                if-feature feature-list:NOT_HAVE_DNX;
                description
                    "This container defines forwarding-profiles custom-TCAM configuration
                            and state information.";
                container config {
                    presence "forwarding-profiles custom-tcam configuration";
                    description
                        "This container defines forwarding-profiles custom-TCAM configuration.";
                    uses platform-custom-tcam-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines forwarding-profiles custom-TCAM Operational
                                states.";
                    uses platform-custom-tcam-config;
                } // END of state-container definition.
            } // END of custom-tcam-container definition.
            container table-limit {
                if-feature feature-list:HAVE_BCM_UFT;
                config false;
                description
                    "This container defines profile table maximum supported values state
                            information.";

                list kaps {
                    if-feature feature-list:HAVE_DUNE;
                    key "profile";
                    config false;
                    description
                        "The list of forwarding-profiles KAPS.";
                    leaf profile  {
                        type  leafref {
                            path  "../state/profile";
                        }
                        description "Forwarding Profile KAPS Profile type.";
                    } // END of profile definition.

                    container state {
                        config false;
                        description
                            "This container defines KAPS information Operational states.";
                        uses platform-kaps-state;
                    } // END of state-container definition.
                } // End of kaps-list

                list external-tcam {
                    if-feature feature-list:HAVE_DUNE;
                    if-feature feature-list:HAVE_ELK_TCAM;
                    key "profile";
                    config false;
                    description
                        "The list of forwarding-profiles external-TCAM.";
                    leaf profile  {
                        type  leafref {
                            path  "../state/profile";
                        }
                        description "Forwarding Profile External TCAM Profile type.";
                    } // END of profile definition.

                    container state {
                        config false;
                        description
                            "This container defines external-TCAM information Operational states.";
                        uses platform-elk-tcam-state;
                    } // END of state-container definition.
                } // End of external-tcam-list
                uses state-grouping;
                uses table-sizes-grouping;
            } // END of table-limit-container definition.
            uses mdb-grouping;
            uses custom-profile-grouping;
            uses hardware-routing-limits-grouping;
        } // END of forwarding-profiles-container definition.
    } // END of profiles-container definition.
    } // END of profiles-grouping definition.

    grouping  hardware-grouping {
    description
        "Top level container for hardware, including configuration and state
                data";
    container hardware {
        if-feature feature-list:HAVE_BROADCOM;
        if-feature feature-list:HAVE_CMMD;
        if-feature feature-list:HAVE_BROADCOM_OR_HAVE_MARVELL;
        description
            "Top level container for hardware, including configuration and state
                    data";
        container hw-soc-property {
            description
                "This container defines hardware SOC property enable configuration and
                        state information.";
            container config {
                description
                    "This container defines hardware load-balance configuration.";
                uses platform-advanced-parser-soc-enable;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "This container defines hardware load-balance Operational states.";
                uses platform-advanced-parser-soc-enable;
            } // END of state-container definition.
        } // END of hw-soc-property-container definition.
        container load-balance {
            if-feature feature-list:HAVE_BROADCOM;
            description
                "This container defines hardware load-balance configuration and state
                        information.";
            container config {
                presence "hardware load-balance configuration";
                description
                    "This container defines hardware load-balance configuration.";
                uses platform-load-balance-config;
                uses platform-extended-load-balance-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "This container defines hardware load-balance Operational states.";
                uses platform-load-balance-config;
                uses platform-extended-load-balance-config;
            } // END of state-container definition.
            container l2 {
                // when " ipi-platform-profile:hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L2;
                description
                    "This container defines load-balance l2 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance l2 configuration.";
                    uses platform-load-balance-l2-config;
                    uses platform-extended-load-balance-l2-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance l2 Operational states.";
                    uses platform-load-balance-l2-config;
                    uses platform-extended-load-balance-l2-config;
                } // END of state-container definition.
                uses inner-l2-grouping;
            } // END of l2-container definition.
            container ipv4 {
                // when " ipi-platform-profile:hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L3;
                description
                    "This container defines load-balance ipv4 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance ipv4 configuration.";
                    uses platform-load-balance-ipv4-config;
                    uses platform-extended-load-balance-ipv4-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance ipv4 Operational states.";
                    uses platform-load-balance-ipv4-config;
                    uses platform-extended-load-balance-ipv4-config;
                } // END of state-container definition.
                uses inner-ipv4-grouping;
            } // END of ipv4-container definition.
            container ipv6 {
                // when " ipi-platform-profile:hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L3;
                description
                    "This container defines load-balance ipv6 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance ipv6 configuration.";
                    uses platform-load-balance-ipv6-config;
                    uses platform-extended-load-balance-ipv6-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance ipv6 Operational states.";
                    uses platform-load-balance-ipv6-config;
                    uses platform-extended-load-balance-ipv6-config;
                } // END of state-container definition.
            } // END of ipv6-container definition.
            uses tunnel-grouping;
            uses vxlan-grouping;
            uses mpls-ler-grouping;
            uses l4-port-grouping;
            uses port-channel-grouping;
        } // END of load-balance-container definition.
        container dram-tune {
            if-feature feature-list:HAVE_BROADCOM;
            config false;
            description
                "This container defines dram-tuning-profiles information.";
            container state {
                config false;
                description
                    "This container defines operational data for dram-tune";
                leaf dram-tune-status  {
                    if-feature feature-list:HAVE_BROADCOM;
                    type  int32;
                    default "0";
                    description "Use this attribute to configure or unconfigure hardware profile
                                service-queue profile support.";
                } // END of dram-tune-status definition.

            } // END of state-container definition.
        } // END of dram-tune-container definition.
        uses platform-cpu-queue-top;
        uses mac-ageing-grouping;
        uses platform-grouping;
        uses cpu-control-grouping;
    } // END of hardware-container definition.
    } // END of hardware-grouping definition.

    grouping  mvl-hardware-grouping {
    description
        "Top level container for Marvell hardware, including configuration and
                state data";
    container mvl-hardware {
        if-feature feature-list:HAVE_MARVELL;
        if-feature feature-list:HAVE_CMMD;
        if-feature feature-list:HAVE_BROADCOM_OR_HAVE_MARVELL;
        description
            "Top level container for Marvell hardware, including configuration and
                    state data";
        container load-balance {
            description
                "This container defines marvell load-balance configuration and state
                        information.";
            container config {
                presence "marvell load-balance configuration";
                description
                    "This container defines Marvell load-balancel configuration.";
                uses mvl-platform-load-balance-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "This container defines marvell load-balance configuration Operational
                            states.";
                uses mvl-platform-load-balance-config;
            } // END of state-container definition.
            container l2 {
                // when " ipi-platform-profile:mvl-hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L2;
                description
                    "This container defines load-balance l2 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance l2 configuration.";
                    uses mvl-platform-load-balance-l2-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance l2 Operational states.";
                    uses mvl-platform-load-balance-l2-config;
                } // END of state-container definition.
                uses inner-l2-grouping;
            } // END of l2-container definition.
            container ipv4 {
                // when " ipi-platform-profile:mvl-hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L3;
                description
                    "This container defines load-balance ipv4 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance ipv4 configuration.";
                    uses mvl-platform-load-balance-ipv4-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance ipv4 Operational states.";
                    uses mvl-platform-load-balance-ipv4-config;
                } // END of state-container definition.
                uses inner-ipv4-grouping;
            } // END of ipv4-container definition.
            container ipv6 {
                // when " ipi-platform-profile:mvl-hardware/load-balance/config/enable ";
                if-feature feature-list:HAVE_L3;
                description
                    "This container defines load-balance ipv6 configuration and state
                            information.";
                container config {
                    description
                        "This container defines load-balance ipv6 configuration.";
                    uses mvl-platform-load-balance-ipv6-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "This container defines load-balance ipv6 Operational states.";
                    uses mvl-platform-load-balance-ipv6-config;
                } // END of state-container definition.
            } // END of ipv6-container definition.
            uses tunnel-grouping;
            uses vxlan-grouping;
            uses mpls-ler-grouping;
            uses l4-port-grouping;
            uses port-channel-grouping;
        } // END of load-balance-container definition.
        uses platform-cpu-queue-top;
    } // END of mvl-hardware-container definition.
    } // END of mvl-hardware-grouping definition.


}