        } // END of ingress-ipv4-subif-extended definition.

        leaf ingress-ipv6-qos  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv6 QoS filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of ingress-ipv6-qos definition.

