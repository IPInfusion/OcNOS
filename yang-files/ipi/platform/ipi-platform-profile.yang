    } // END of hardware-profile-config definition.
    grouping hardware-profile-filters-config {
        description
            "Grouping for hardware-profile filter config objects.";
        leaf ingress-ip-outer  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable the outer ip header filter";
        } // END of ingress-ip-outer definition.

        leaf egress-ipv6  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:NOT_HAVE_DUNE;
            type  cml-data-types:cml_enable_disable_t;
            description "Use this attribute to enable or disable Egress IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-ipv6 definition.

        leaf egress-dst-ipv6  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable Egress Dst IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-dst-ipv6 definition.

        leaf egress-src-ipv6  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable Egress Src IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-src-ipv6 definition.

        leaf egress-ipv6-dnx  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this command to enable or disable egress IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-ipv6-dnx definition.

        leaf ingress-ipv6  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of ingress-ipv6 definition.

        leaf twamp-ipv4  {
            if-feature feature-list:HAVE_TWAMP_HW_OFFLOAD;
            if-feature feature-list:HAVE_TWAMP;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable TWAMP IPv4 Forwarding filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of twamp-ipv4 definition.

        leaf qos-policer  {
            // when " !ipi-platform-profile:profiles/hardware-profile/filters/config/qos + !ipi-platform-profile:profiles/hardware-profile/filters/config/qos-extended ";
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable QoS policer filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of qos-policer definition.

        leaf qos-subif-policer  {
            // when " !ipi-platform-profile:profiles/hardware-profile/filters/config/qos + !ipi-platform-profile:profiles/hardware-profile/filters/config/qos-extended + !ipi-platform-profile:profiles/hardware-profile/filters/config/qos-policer ";
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable QoS subif policer filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of qos-subif-policer definition.

        leaf qos-ipv6  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable QoS filter group for IPv6
                        traffic. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of qos-ipv6 definition.

        leaf ingress-ipv6-acl  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:NOT_HAVE_DUNE;
            type  cml-data-types:cml_enable_disable_t;
            description "Use this attribute to enable or disable Ingress IPv6 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of ingress-ipv6-acl definition.

        leaf ipv4-bgp-flowspec  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:HAVE_BGP_FLOWSPEC;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv4 BGP FLOWSPEC
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of ipv4-bgp-flowspec definition.

        leaf qos-extended  {
            // when " !ipi-platform-profile:profiles/hardware-profile/filters/config/qos + !ipi-platform-profile:profiles/hardware-profile/filters/config/qos-policer ";
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable QoS extended filter groups.
