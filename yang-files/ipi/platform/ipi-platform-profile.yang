        } // END of ingress-ipv6-extended definition.

        leaf ingress-ipv6-extended-vlan  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv6 extended vlan
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of ingress-ipv6-extended-vlan definition.

        leaf ingress-ipv6-extended-subif  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv6 extended subif
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of ingress-ipv6-extended-subif definition.

        leaf ingress-ipv4-custom0  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:NOT_HAVE_DUNE;
            type  cml-data-types:cml_enable_disable_t;
            description "Use this attribute to enable or disable Ingress IPv4 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of ingress-ipv4-custom0 definition.

        leaf ingress-ipv4-subif  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv4 extended filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of ingress-ipv4-subif definition.

        leaf ingress-arp  {
            if-feature feature-list:HAVE_ACL;
            type  empty;
            description "Use this attribute to enable or disable Ingress ARP filter groups.";
