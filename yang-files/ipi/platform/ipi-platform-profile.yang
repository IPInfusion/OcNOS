            if-feature feature-list:HAVE_DNX;
            if-feature feature-list:HAVE_COPP_FILTER;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv4 QoS and CoPP
                        filter groups. Disabling filter groups increases the configurable
                        filter entries.";
        } // END of ingress-ipv4-qos-copp definition.

        leaf ingress-layer2-extended  {
            // when " !ipi-platform-profile:profiles/hardware-profile/filters/config/ingress-layer2 ";
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress L2 extended filter
                        groups. Disabling filter groups increases the configurable filter
                        entries.";
        } // END of ingress-layer2-extended definition.

        leaf ingress-ipv6-extended  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable Ingress IPv6 extended filter
