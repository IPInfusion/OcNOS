    grouping hardware-profile-config {
        description
            "Grouping for hardware-profile config objects.";
        leaf flow-control  {
            if-feature feature-list:HAVE_BCM_UFT;
            if-feature feature-list:HAVE_DUNE;
            type  empty;
            description "Use this attribute to enable or disable hardware profile flowcontrol.";
        } // END of flow-control definition.

        leaf aclif  {
            if-feature feature-list:HAVE_DUNE;
            type  ipi-platform-profile-types:platform_aclif_type_t;
            description "Use this attribute to set or unset the hardware profile aclif";
        } // END of aclif definition.

        leaf seamless-bfd  {
            if-feature feature-list:HAVE_CUSTOM1_HW_BFD;
            if-feature feature-list:HAVE_SBFD;
            type  empty;
            description "Use this attribute to enable or disable hardware profile seamless-bfd.";
        } // END of seamless-bfd definition.

        leaf kbp-disable  {
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable kbp hardware profile.";
        } // END of kbp-disable definition.

        leaf ufis9600-64x-port-mode  {
            if-feature feature-list:HAVE_DUNE;
            type  ipi-platform-profile-types:platform_ufis9600_64x_port_mode_type_t;
            default "mode1";
            description "use this attribute to configure or unconfigure hardware profile port
                        modes";
        } // END of ufis9600-64x-port-mode definition.

        leaf as7315_27x-port-mode  {
            if-feature feature-list:HAVE_DUNE;
            type  ipi-platform-profile-types:platform_as7315_27x_port_mode_type_t;
            default "mode1";
            description "use this attribute to configure or unconfigure hardware profile port
                        modes";
        } // END of as7315_27x-port-mode definition.

        leaf as5916_as5912_54x-port-mode  {
            if-feature feature-list:HAVE_DUNE;
