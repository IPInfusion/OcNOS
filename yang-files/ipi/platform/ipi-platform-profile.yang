            description "Use this attribute to enable or disable Egress IPv4 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-ipv4-dnx definition.

        leaf egress-l2-mlag  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable Egress l2 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-l2-mlag definition.

        leaf egress-ipv4-ext  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Egress IPv4 ext filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-ipv4-ext definition.

        leaf egress-layer2  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DUNE;
            if-feature feature-list:NOT_HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable Egress L2 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-layer2 definition.

        leaf egress-layer2-dnx  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_CUSTOM3_ACL;
            type  empty;
            description "Use this attribute to enable or disable Egress L2 filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-layer2-dnx definition.

        leaf egress-layer2-ext  {
            if-feature feature-list:HAVE_ACL;
            if-feature feature-list:HAVE_DNX;
            type  empty;
            description "Use this attribute to enable or disable Egress L2 ext filter groups.
                        Disabling filter groups increases the configurable filter entries.";
        } // END of egress-layer2-ext definition.

        leaf ingress-layer2-subif  {
            // when " !ipi-platform-profile:profiles/hardware-profile/filters/config/ingress-layer2 ";
            if-feature feature-list:HAVE_ACL;
