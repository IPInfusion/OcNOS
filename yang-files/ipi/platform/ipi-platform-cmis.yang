            } // END of forced-tx-output-squelching definition.

            leaf tx-output-squelching-disable  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether the host can disable automatic squelching of the Tx
                            outputs or not";
            } // END of tx-output-squelching-disable definition.

            leaf tx-output-disable  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether the host can disable the Tx outputs or not";
            } // END of tx-output-disable definition.

            leaf input-polarity-flip-tx  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether InputPolarityFlipTx is supported or not";
            } // END of input-polarity-flip-tx definition.

            leaf rx-output-squelching-disable  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether the host can disable automatic squelching of the Rx
                            outputs or not";
            } // END of rx-output-squelching-disable definition.

            leaf rx-output-disable  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether the host can disable the Rx outputs or not";
            } // END of rx-output-disable definition.

            leaf output-polarity-flip-rx  {
                type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
                description "Indicates whether OutputPolarityFlipRx is supported or not";
            } // END of output-polarity-flip-rx definition.

        } // END of state-container definition.
    } // END of ipi-platform-cmis-module-advertisement-controls-top definition.
    grouping ipi-platform-cmis-module-advertisement-diagnostics-module-state {
        description
            "ipi-platform-cmis-module-advertisement-diagnostics-module-state";
        leaf simultaneous-host-and-media-loobpack  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether simultaneous host and media side loopback is
                        supported or not";
        } // END of simultaneous-host-and-media-loobpack definition.

        leaf report-bit-error-ratio  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether reporting of bit error ratio is supported or not";
        } // END of report-bit-error-ratio definition.

        leaf count-bits-and-errors  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether counting of bits and bit erros is supported or not";
        } // END of count-bits-and-errors definition.

        leaf media-side-fec-prbs-error  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether media side PRBS error information is supported or
                        not";
        } // END of media-side-fec-prbs-error definition.

        leaf host-side-fec-prbs-error  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether host side PRBS error information is supported or not";
        } // END of host-side-fec-prbs-error definition.

        leaf media-side-input-snr-measurement  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether media side SNR measurement is supported or not";
        } // END of media-side-input-snr-measurement definition.

        leaf host-side-input-snr-measurement  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether host side SNR measurement is supported or not";
        } // END of host-side-input-snr-measurement definition.

        leaf gating-support  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether gated performance monitoring (PM) is supported or
                        not";
        } // END of gating-support definition.

        leaf gating-results  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether reporting gated performance monitoring (PM) is
                        supported or not";
        } // END of gating-results definition.

        leaf periodic-updates  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether real-time statistics are periodically updated during
                        measurement or not";
        } // END of periodic-updates definition.

        leaf per-lane-gating-timers  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether per lane gating timers are supported in all banks or
                        not";
        } // END of per-lane-gating-timers definition.

        leaf gating-auto-restart  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether auto-restart gating control is supported or not";
        } // END of gating-auto-restart definition.

    } // END of ipi-platform-cmis-module-advertisement-diagnostics-module-state definition.
    grouping ipi-platform-cmis-module-advertisement-diagnostics-state {
        description
            "ipi-platform-cmis-module-advertisement-diagnostics-state";
        leaf output-loopack  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether output loopback is supported or not";
        } // END of output-loopack definition.

        leaf input-loopack  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether input loopback is supported or not";
        } // END of input-loopack definition.

        leaf per-lane-loopack  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether per lane loopback is supported or not";
        } // END of per-lane-loopack definition.

        leaf report-input-snr  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether input SNR reporting is supported or not";
        } // END of report-input-snr definition.

        leaf report-fec  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether PRBS error information is available or not";
        } // END of report-fec definition.

        leaf prbs-checker-post-fec  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether post FEC PRBS checker is supported or not";
        } // END of prbs-checker-post-fec definition.

        leaf prbs-checker-pre-fec  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether pre FEC PRBS checker is supported or not";
        } // END of prbs-checker-pre-fec definition.

        leaf prbs-checker-types  {
            type  ipi-platform-cmis-types:cmm_cmis_prbs_support_type_t;
            description "Show supported PRBS checker pattern types";
        } // END of prbs-checker-types definition.

        leaf prbs-generator-post-fec  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether post FEC PRBS generator is supported or not";
        } // END of prbs-generator-post-fec definition.

        leaf prbs-generator-pre-fec  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether pre FEC PRBS generator is supported or not";
        } // END of prbs-generator-pre-fec definition.

        leaf prbs-generator-types  {
            type  ipi-platform-cmis-types:cmm_cmis_prbs_support_type_t;
            description "Show supported PRBS generator pattern types";
        } // END of prbs-generator-types definition.

    } // END of ipi-platform-cmis-module-advertisement-diagnostics-state definition.
    grouping ipi-platform-cmis-module-advertisement-diagnostics-top {
        description
            "ipi-platform-cmis-module-advertisement-diagnostics-top";
        container module {
            config false;
            description
                "CMIS module wise advertised diagnostics";
            container state {
                config false;
                description
                    "State data for CMIS module wise advertised diagnostics";
                uses ipi-platform-cmis-module-advertisement-diagnostics-module-state;
            } // END of state-container definition.
        } // END of module-container definition.
        container host {
            config false;
            description
                "CMIS host side advertised diagnostics";
            container state {
                config false;
                description
                    "State data for CMIS host side advertised diagnostics";
                uses ipi-platform-cmis-module-advertisement-diagnostics-state;
            } // END of state-container definition.
        } // END of host-container definition.
        container media {
            config false;
            description
                "CMIS media side advertised diagnostics";
            container state {
                config false;
                description
                    "State data for CMIS media side advertised diagnostics";
                uses ipi-platform-cmis-module-advertisement-diagnostics-state;
            } // END of state-container definition.
        } // END of media-container definition.
    } // END of ipi-platform-cmis-module-advertisement-diagnostics-top definition.
    grouping ipi-platform-cmis-module-advertisement-durations-top {
        description
            "ipi-platform-cmis-module-advertisement-durations-top";
        container state {
            config false;
            description
                "State data for CMIS advertised durations";
            leaf modsel-wait-time  {
                type  uint32;
                units "us";
                description "ModSel wait time in micro seconds";
            } // END of modsel-wait-time definition.

            leaf dpinit-maximun-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "DPInit state maximum duration";
            } // END of dpinit-maximun-duration definition.

            leaf dpdeinit-maximun-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "DPDeinit state maximum duration";
            } // END of dpdeinit-maximun-duration definition.

            leaf dptxturnon-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "DPTxTurnOn state maximum duration";
            } // END of dptxturnon-maximum-duration definition.

            leaf dptxturnoff-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "DPTxTurnOff state maximum duration";
            } // END of dptxturnoff-maximum-duration definition.

            leaf modulepwrup-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "ModulePwrUp state maximum duration";
            } // END of modulepwrup-maximum-duration definition.

            leaf modulepwrdn-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "MoudulePwrDn state maximum duration";
            } // END of modulepwrdn-maximum-duration definition.

            leaf npinit-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "NPInit state maximum duration";
            } // END of npinit-maximum-duration definition.

            leaf npdeinit-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "NPDeinit state maximum duration";
            } // END of npdeinit-maximum-duration definition.

            leaf nptxturnon-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "NPTxTurnOn state maximum duration";
            } // END of nptxturnon-maximum-duration definition.

            leaf nptxturnoff-maximum-duration  {
                type  ipi-platform-cmis-types:cmm_cmis_durations_t;
                description "NPTxTurnOff state maximum duration";
            } // END of nptxturnoff-maximum-duration definition.

        } // END of state-container definition.
    } // END of ipi-platform-cmis-module-advertisement-durations-top definition.
    grouping ipi-platform-cmis-module-advertisement-laser-state {
        description
            "ipi-platform-cmis-module-advertisement-laser-state";
        leaf supported-grids  {
            type  ipi-platform-cmis-types:cmm_cmis_laser_grid_support_t;
            description "Shows supported laser grids";
        } // END of supported-grids definition.

        leaf fine-tune-supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether laser fine tuning is supported or not";
        } // END of fine-tune-supported definition.

        leaf fine-tune-resolution  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "GHz";
            description "Fine tune resolution in GHz";
        } // END of fine-tune-resolution definition.

        leaf fine-tune-low-offset  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "GHz";
            description "Fine tune low offset in GHz";
        } // END of fine-tune-low-offset definition.

        leaf fine-tune-high-offset  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "GHz";
            description "Fine tune high offset in GHz";
        } // END of fine-tune-high-offset definition.

        leaf per-lane-programmable-output-power  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether programming of output power per lane is supported or
                        not";
        } // END of per-lane-programmable-output-power definition.

        leaf minimum-programmable-output-power  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "dBm";
            description "Minimum value for programmable output power in dBm";
        } // END of minimum-programmable-output-power definition.

        leaf maximum-programmable-output-power  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "dBm";
            description "Maximum value for programmable output power in dBm";
        } // END of maximum-programmable-output-power definition.

    } // END of ipi-platform-cmis-module-advertisement-laser-state definition.
    grouping ipi-platform-cmis-module-advertisement-laser-grid-state {
        description
            "ipi-platform-cmis-module-advertisement-laser-grid-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_laser_grid_spacing_t;
            description "Grid spacing ID";
        } // END of id definition.

        leaf lowest-channel-frequency  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "THz";
            description "Grid lowest channel frequency in THz";
        } // END of lowest-channel-frequency definition.

        leaf highest-channel-frequency  {
            type  decimal64 {
                 fraction-digits 3;            }
            units "THz";
            description "Grid highest channel frequency in THz";
        } // END of highest-channel-frequency definition.

        leaf channel-count  {
            type  uint16;
            description "Total number of grid channels";
        } // END of channel-count definition.

    } // END of ipi-platform-cmis-module-advertisement-laser-grid-state definition.
    grouping ipi-platform-cmis-module-advertisement-laser-top {
        description
            "ipi-platform-cmis-module-advertisement-laser-top";
        container state {
            config false;
            description
                "State data for CMIS advertised laser tuning support";
            uses ipi-platform-cmis-module-advertisement-laser-state;
        } // END of state-container definition.
        container grids {
            config false;
            description
                "High level container for list of supported grids";

            list grid {
                key "id";
                config false;
                description
                    "List of grid spacing details";
                leaf id  {
                    type  leafref {
                        path  "../state/id";
                    }
                    description "Grid spacing ID";
                } // END of id definition.

                container state {
                    config false;
                    description
                        "State data for laser grid spacing information";
                    uses ipi-platform-cmis-module-advertisement-laser-grid-state;
                } // END of state-container definition.
            } // End of grid-list
        } // END of grids-container definition.
    } // END of ipi-platform-cmis-module-advertisement-laser-top definition.
    grouping ipi-platform-cmis-module-advertisement-monitoring-module-state {
        description
            "ipi-platform-cmis-module-advertisement-monitoring-module-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_module_monitor_id_t;
            description "Module monitor ID";
        } // END of id definition.

        leaf supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether this monitor ID is supported or not";
        } // END of supported definition.

    } // END of ipi-platform-cmis-module-advertisement-monitoring-module-state definition.
    grouping ipi-platform-cmis-module-advertisement-host-monitor-state {
        description
            "ipi-platform-cmis-module-advertisement-host-monitor-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_host_monitor_id_t;
            description "Host side monitor ID";
        } // END of id definition.

    } // END of ipi-platform-cmis-module-advertisement-host-monitor-state definition.
    grouping ipi-platform-cmis-module-advertisement-host-flag-state {
        description
            "ipi-platform-cmis-module-advertisement-host-flag-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_host_flag_id_t;
            description "Host side flag ID";
        } // END of id definition.

    } // END of ipi-platform-cmis-module-advertisement-host-flag-state definition.
    grouping ipi-platform-cmis-module-advertisement-media-monitor-state {
        description
            "ipi-platform-cmis-module-advertisement-media-monitor-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_media_monitor_id_t;
            description "Media side monitor ID";
        } // END of id definition.

    } // END of ipi-platform-cmis-module-advertisement-media-monitor-state definition.
    grouping ipi-platform-cmis-module-advertisement-media-flag-state {
        description
            "ipi-platform-cmis-module-advertisement-media-flag-state";
        leaf id  {
            type  ipi-platform-cmis-types:cmm_cmis_media_flag_id_t;
            description "Media side flag ID";
        } // END of id definition.

    } // END of ipi-platform-cmis-module-advertisement-media-flag-state definition.
    grouping ipi-platform-cmis-module-advertisement-monitor-state-details {
        description
            "ipi-platform-cmis-module-advertisement-monitor-state-details";
        leaf supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether this monitor/flag ID is supported or not";
        } // END of supported definition.

        leaf lanes-assigned  {
            type  ipi-platform-cmis-types:cmm_cmis_lane_assignment_t;
            description "Bitmap of which lanes support this monitor/flag ID";
        } // END of lanes-assigned definition.

    } // END of ipi-platform-cmis-module-advertisement-monitor-state-details definition.
    grouping ipi-platform-cmis-module-advertisement-monitoring-top {
        description
            "ipi-platform-cmis-module-advertisement-monitoring-top";
        container module {
            config false;
            description
                "State data for advertised module monitors";
            container monitors {
                config false;
                description
                    "High level container for the list of advertised module monitors";

                list monitor {
                    key "id";
                    config false;
                    description
                        "List of advertised module monitors";
                    leaf id  {
                        type  leafref {
                            path  "../state/id";
                        }
                        description "Module monitor ID";
                    } // END of id definition.

                    container state {
                        config false;
                        description
                            "State data for advertised module monitors";
                        uses ipi-platform-cmis-module-advertisement-monitoring-module-state;
                    } // END of state-container definition.
                } // End of monitor-list
            } // END of monitors-container definition.
        } // END of module-container definition.
        container host {
            config false;
            description
                "State data for advertised host side monitors";
            container monitors {
                config false;
                description
                    "High level container for the list of advertised host side monitors";

                list monitor {
                    key "id";
                    config false;
                    description
                        "List of advertised host side monitors";
                    leaf id  {
                        type  leafref {
                            path  "../state/id";
                        }
                        description "Host side monitor ID";
                    } // END of id definition.

                    container state {
                        config false;
                        description
                            "State data for advertised host side monitors";
                        uses ipi-platform-cmis-module-advertisement-host-monitor-state;
                        uses ipi-platform-cmis-module-advertisement-monitor-state-details;
                    } // END of state-container definition.
                } // End of monitor-list
            } // END of monitors-container definition.
            container flags {
                config false;
                description
                    "High level container for the list of advertised host side flags";

                list flag {
                    key "id";
                    config false;
                    description
                        "List of advertised host side flags";
                    leaf id  {
                        type  leafref {
                            path  "../state/id";
                        }
                        description "Host side flag ID";
                    } // END of id definition.

                    container state {
                        config false;
                        description
                            "State data for advertised host side flags";
                        uses ipi-platform-cmis-module-advertisement-host-flag-state;
                        uses ipi-platform-cmis-module-advertisement-monitor-state-details;
                    } // END of state-container definition.
                } // End of flag-list
            } // END of flags-container definition.
        } // END of host-container definition.
        container media {
            config false;
            description
                "State data for advertised media side monitors";
            container monitors {
                config false;
                description
                    "High level container for the list of advertised media side monitors";

                list monitor {
                    key "id";
                    config false;
                    description
                        "List of advertised media side monitors";
                    leaf id  {
                        type  leafref {
                            path  "../state/id";
                        }
                        description "Media side monitor ID";
                    } // END of id definition.

                    container state {
                        config false;
                        description
                            "State data for advertised media side monitors";
                        uses ipi-platform-cmis-module-advertisement-media-monitor-state;
                        uses ipi-platform-cmis-module-advertisement-monitor-state-details;
                    } // END of state-container definition.
                } // End of monitor-list
            } // END of monitors-container definition.
            container flags {
                config false;
                description
                    "High level container for the list of advertised media side flags";

                list flag {
                    key "id";
                    config false;
                    description
                        "List of advertised media side flags";
                    leaf id  {
                        type  leafref {
                            path  "../state/id";
                        }
                        description "Media side flag ID";
                    } // END of id definition.

                    container state {
                        config false;
                        description
                            "State data for advertised media side monitors";
                        uses ipi-platform-cmis-module-advertisement-media-flag-state;
                        uses ipi-platform-cmis-module-advertisement-monitor-state-details;
                    } // END of state-container definition.
                } // End of flag-list
            } // END of flags-container definition.
        } // END of media-container definition.
    } // END of ipi-platform-cmis-module-advertisement-monitoring-top definition.
    grouping ipi-platform-cmis-module-advertisement-pages-state {
        description
            "ipi-platform-cmis-module-advertisement-pages-state";
        leaf network-path-pages-supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether network path pages are supported or not";
        } // END of network-path-pages-supported definition.

        leaf vdm-pages-supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether VDM pages are supported or not";
        } // END of vdm-pages-supported definition.

        leaf vdm-groups  {
            type  ipi-platform-cmis-types:cmm_cmis_vdm_pages_support_t;
            description "Shows which VDM groups are supported in case VDM pages are supported";
        } // END of vdm-groups definition.

        leaf diagnostics-pages-supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether diagnostics pages are supported or not";
        } // END of diagnostics-pages-supported definition.

        leaf user-page-supported  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether user eeprom page (page 03h) is supported or not";
        } // END of user-page-supported definition.

        leaf banks-per-page  {
            type  ipi-platform-cmis-types:cmm_cmis_bank_per_page_support_t;
            description "Shows which banks are supported for pages 10h to 2Fh";
        } // END of banks-per-page definition.

    } // END of ipi-platform-cmis-module-advertisement-pages-state definition.
    grouping ipi-platform-cmis-module-advertisement-pages-top {
        description
            "ipi-platform-cmis-module-advertisement-pages-top";
        container state {
            config false;
            description
                "State data for CMIS advertised pages";
            uses ipi-platform-cmis-module-advertisement-pages-state;
        } // END of state-container definition.
    } // END of ipi-platform-cmis-module-advertisement-pages-top definition.
    grouping ipi-platform-cmis-module-advertisement-si-state {
        description
            "ipi-platform-cmis-module-advertisement-si-state";
        leaf tx-input-manual-eq  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether manual Tx input equalizer is supported or not";
        } // END of tx-input-manual-eq definition.

        leaf tx-input-eq-max  {
            type  uint8;
            description "Maximum supported value for Tx input equalizer";
        } // END of tx-input-eq-max definition.

        leaf rx-output-eq-pre-cursor  {
            type  ipi-platform-cmis-types:cmm_cmis_yes_no_t;
            description "Indicates whether manual Rx output equalizer pre cursor is supported
                        or not";
        } // END of rx-output-eq-pre-cursor definition.

        leaf rx-output-eq-pre-cursor-max  {
            type  uint8;
            description "Maximum supported value for Rx output equalizer pre cursor";
        } // END of rx-output-eq-pre-cursor-max definition.

