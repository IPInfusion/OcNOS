                        description
                            "List of telemetry stream destinatios";
                        leaf destination-address  {
                            type  leafref {
                                path  "../config/destination-address";
                            }
                            description "Reference to the destination address of the telemetry stream";
                        } // END of destination-address definition.

                        leaf destination-port  {
                            type  leafref {
                                path  "../config/destination-port";
                            }
                            description "Reference to the port number of the stream destination";
                        } // END of destination-port definition.

                        container config {
                            description
                                "Configuration parameters relating to telemetry destinations";
                            uses telemetry-stream-destination-config;
                        } // END of config-container definition.
                        container state {
                            config false;
                            description
                                "State information associated with telemetry destinations";
                            uses telemetry-stream-destination-config;
                        } // END of state-container definition.
                    } // End of destination-list
                } // END of destinations-container definition.
            } // End of destination-group-list
        } // END of destination-groups-container definition.
    } // END of streaming-telemetry-destination-groups definition.
    grouping telemetry-subscription-config {
        description
            "This grouping holds information related to persistent configurations";
        leaf name  {
            type  string {
                length "1..64";
                pattern "[^?' =,>|]+";
            }
            description "User configured identifier of the telemetry subscription. This value
                        is used primarily for subscriptions configured locally on the network
                        element";
        } // END of name definition.

        leaf encoding  {
            type  ipi-streaming-telemetry-types:cml_data_encode_t;
            description "Selection of the specific encoding or RPC framework for telemetry
                        messages to and from the network element. The encoding method controls
                        specifically the wire format of the telemetry data, and also controls
                        which RPC framework may be in use to exchange telemetry data";
        } // END of encoding definition.

    } // END of telemetry-subscription-config definition.
    grouping telemetry-subscription-state-configs {
        description
            "This grouping holds information related to persistent state info";
        leaf id  {
            type  uint64;
            description "System generated identifer of the telemetry subscription";
        } // END of id definition.

        leaf subscription-status  {
            type  ipi-streaming-telemetry-types:cml_telemetry_status_t;
            description "Status of the subscription";
        } // END of subscription-status definition.

        leaf inactive-cause  {
            type  string {
                length "1..1965";
            }
            description "Reason for inactive subscriptions";
        } // END of inactive-cause definition.

        leaf protocol  {
            type  ipi-streaming-telemetry-types:cml_telemetry_protocol_t;
            description "Selection of the transport protocol for the telemetry stream";
        } // END of protocol definition.

    } // END of telemetry-subscription-state-configs definition.
    grouping telemetry-sensor-profile-config {
        description
            "Configuration parameters relating to the sensor groups used in the
                        sensor profile";
        leaf sensor-group  {
            type  leafref {
                path  "/telemetry-system/vrfs/vrf/sensor-groups/sensor-group/sensor-group-id";
            }
            description "Reference to the sensor group which is used in the profile";
        } // END of sensor-group definition.

        leaf sample-interval  {
            type  uint64 {
                 range "10..3600"  {
                    description "10..3600: Supported range 10 - 3600";
                 }
            }
            units "seconds";
            mandatory true;
            description "Time in seconds between the device's sample of a telemetry data source";
        } // END of sample-interval definition.

    } // END of telemetry-sensor-profile-config definition.
    grouping telemetry-destination-profile-config {
        description
            "Configuration parameters related to telemetry destinations";
        leaf group-id  {
            type  leafref {
                path  "/telemetry-system/vrfs/vrf/destination-groups/destination-group/group-id";
            }
            description "The destination group id references a reusable group of destination
                        addresses and ports for the telemetry stream";
        } // END of group-id definition.

    } // END of telemetry-destination-profile-config definition.
    grouping streaming-telemetry-dial-out-top {
        description
            "This grouping holds information relating to persistent telemetry
                        subscriptions";
        container persistent-subscriptions {
            description
                "A persistent telemetry subscription is configued locally on the device
                        through configuration, and is persistent across device restarts or
                        other redundancy changes";

            list persistent-subscription {
            when " /ipi-streaming-telemetry:telemetry-system/ipi-streaming-telemetry:vrfs/ipi-streaming-telemetry:vrf/ipi-streaming-telemetry:streaming-telemetry/ipi-streaming-telemetry:config/ipi-streaming-telemetry:feature-enabled ";
                key "name";
                description
                    "List of telemetry subscriptions. A telemetry subscription consists of
                                a set of collection destinations, stream attributes, and associated
                                paths to state information in the model";
                leaf name  {
                    type  leafref {
                        path  "../config/name";
                    }
                    description "Reference to the identifier of the subscription itself. The id will be
                                the handle to refer to the subscription once created";
                } // END of name definition.

                container config {
                    description
                        "Config parameters relating to the telemetry subscriptions on the local
                                device";
                    uses telemetry-subscription-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "State parameters relating to the telemetry subscriptions on the local
                                device";
                    uses telemetry-subscription-config;
                    uses telemetry-subscription-state-configs;
                } // END of state-container definition.
                container sensor-profiles {
                    description
                        "A sensor profile is a set of sensor groups or individual sensor paths
                                which are associated with a telemetry subscription";

                    list sensor-profile {
                        key "sensor-group";
                        description
                            "List of telemetry sensor groups used in the subscription";
                        leaf sensor-group  {
                            type  leafref {
                                path  "../config/sensor-group";
                            }
                            description "Reference to the telemetry sensor group name";
                        } // END of sensor-group definition.

                        container config {
                            description
                                "Configuration parameters related to the sensor profile for a
                                        subscription";
                            uses telemetry-sensor-profile-config;
                        } // END of config-container definition.
                        container state {
                            config false;
                            description
                                "State information relating to the sensor profile for a subscription";
                            uses telemetry-sensor-profile-config;
                        } // END of state-container definition.
                    } // End of sensor-profile-list
                } // END of sensor-profiles-container definition.
                container destination-groups {
                    description
                        "A subscription may specify destination addresses.If the subscription
                                supplies destination addresses, the network element will be the
                                initiator of the telemetry streaming, sending it to the destination(s)
                                specified.";

                    list destination-group {
                        key "group-id";
                        description
                            "Identifier of the previously defined destination group";
                        leaf group-id  {
                            type  leafref {
                                path  "../config/group-id";
                            }
                            description "The destination group id references a configured group of destinations
                                        for the telemetry stream";
                        } // END of group-id definition.

                        container config {
                            description
                                "Configuration parameters related to telemetry destinations";
                            uses telemetry-destination-profile-config;
                        } // END of config-container definition.
                        container state {
                            config false;
                            description
                                "State information related to telemetry destinations";
                            uses telemetry-destination-profile-config;
                        } // END of state-container definition.
                    } // End of destination-group-list
                } // END of destination-groups-container definition.
            } // End of persistent-subscription-list
        } // END of persistent-subscriptions-container definition.
    } // END of streaming-telemetry-dial-out-top definition.
    grouping streaming-telemetry-subscription-groups {
        description
            "Grouping related to stream subscriptions";
        container subscriptions {
            description
                "This container holds information for both persistent and dynamic
                        telemetry subscriptions";
            uses streaming-telemetry-dial-in-top;
            uses streaming-telemetry-dial-out-top;
        } // END of subscriptions-container definition.
    } // END of streaming-telemetry-subscription-groups definition.
    grouping telemetry-cpu-monitoring {
        description
            "Configuration objects related to CPU Utilization";
        container cpu-monitoring {
            description
                "CPU utilization container";
            container config {
                when " /ipi-streaming-telemetry:telemetry-system/ipi-streaming-telemetry:vrfs/ipi-streaming-telemetry:vrf/ipi-streaming-telemetry:streaming-telemetry/ipi-streaming-telemetry:config/ipi-streaming-telemetry:feature-enabled ";
                presence "enable-cpu-limit";
                description
                    "Configuration data for cpu-utlization";
                uses telemetry-cpu-monitoring-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational data for cpu-utlization";
                uses telemetry-cpu-monitoring-config;
            } // END of state-container definition.
            uses telemetry-cpu-monitoring-sensor-group;
        } // END of cpu-monitoring-container definition.
    } // END of telemetry-cpu-monitoring definition.
    grouping telemetry-cpu-monitoring-config {
        description
            "Configuration objects related to CPU Utilization configs";
        leaf enable-cpu-limit  {
            type  ipi-streaming-telemetry-types:cml_telemetry_cpu_monitoring_t;
            mandatory true;
            description "Enable CPU monitoring for streaming telemetry";
        } // END of enable-cpu-limit definition.

        leaf suppress-threshold  {
            type  uint16 {
                 range "20..80"  {
                    description "20..80: Supported range 20 - 80";
                 }
            }
            default "40";
            description "Set CPU threshold for suppressing active streaming";
        } // END of suppress-threshold definition.

    } // END of telemetry-cpu-monitoring-config definition.
    grouping telemetry-cpu-monitoring-sensor-group {
        description
            "Configuration objects related to do not suppress sensor group";
        container no-suppress-grps {
            description
                "CPU utilization container";

            list no-suppress-grp {
                if-feature feature-list:HAVE_VRF;
                key "vrf-name sensor-group-id";
                description
                    "List of suppressed groups";
                leaf vrf-name  {
                    type  leafref {
                        path  "../config/vrf-name";
                    }
                    description "VRF Name associated with this instance";
                } // END of vrf-name definition.

                leaf sensor-group-id  {
                    type  leafref {
                        path  "../config/sensor-group-id";
                    }
                    description "Reference to the sensor group which is used in the profile";
                } // END of sensor-group-id definition.

                container config {
                    presence "CPU Utilization";
                    description
                        "Configuration data for cpu-utlization";
                    uses telemetry-cpu-monitoring-sensor-group-config;
                } // END of config-container definition.
                container state {
                    presence "CPU Utilization";
                    description
                        "State data for cpu-utlization";
                    uses telemetry-cpu-monitoring-sensor-group-config;
                } // END of state-container definition.
            } // End of no-suppress-grp-list
        } // END of no-suppress-grps-container definition.
    } // END of telemetry-cpu-monitoring-sensor-group definition.
    grouping telemetry-cpu-monitoring-sensor-group-config {
        description
            "Configuration objects related to do not suppress sensor group";
        leaf vrf-name  {
            if-feature feature-list:HAVE_VRF;
            type  leafref {
                path  "/telemetry-system/vrfs/vrf/vrf-name";
            }
            description "VRF Name associated with this instance";
        } // END of vrf-name definition.

        leaf sensor-group-id  {
            type  leafref {
                path  "/telemetry-system/vrfs/vrf/sensor-groups/sensor-group/sensor-group-id";
            }
            description "Reference to the sensor group which is used in the profile";
        } // END of sensor-group-id definition.

    } // END of telemetry-cpu-monitoring-sensor-group-config definition.

    grouping  telemetry-system-grouping {
    description
        "Top level container for device's streaming telemetry configurations";
    container telemetry-system {
        if-feature feature-list:HAVE_CMLD;
        if-feature feature-list:HAVE_TELEMETRY;
        description
            "Top level container for device's streaming telemetry configurations";
        uses streaming-telemetry-global-top;
        uses streaming-telemetry-subsystem-top;
        uses streaming-telemetry-debug;
        uses telemetry-cpu-monitoring;
    } // END of telemetry-system-container definition.
    } // END of telemetry-system-grouping definition.

    uses telemetry-system-grouping;

}