            type  uint32 {
                 range "1..1023"  {
                    description "1..1023: Supported range 1 - 1023";
                 }
            }
            description "ERSPAN session id";
        } // END of erspan-id definition.

        leaf origin-ip  {
            type  inet:ip-address;
            description "Set the origin IP of the GRE tunnel";
        } // END of origin-ip definition.

        leaf ttl  {
            type  uint16 {
                 range "1..255"  {
                    description "1..255: Supported range 1 - 255";
                 }
            }
            description "This attribute is used to set time to live";
        } // END of ttl definition.

        leaf dscp  {
            type  uint8 {
                 range "0..63"  {
                    description "0..63: Supported range 0 - 63";
                 }
            }
            description "Use this attribute to set the DSCP value used for the GRE tunnel";
        } // END of dscp definition.

        leaf enable-truncate  {
            type  boolean;
            description "Enable/Disable packet truncate on the ERSPAN sender session";
        } // END of enable-truncate definition.

        leaf erspan-type  {
            type  ipi-port-mirror-types:pmirror_erspan_type_t;
            description "Use this attribute to set the ERSPAN type";
        } // END of erspan-type definition.

        leaf hardware-id  {
            type  uint8 {
                 range "0..63"  {
                    description "0..63: Supported range 0 - 63";
                 }
            }
            description "Unique identifier of an ERSPAN engine within a system.";
        } // END of hardware-id definition.

        leaf switch-id  {
            type  uint16 {
                 range "0..511"  {
                    description "0..511: Supported range 0 - 511";
                 }
            }
            description "Use this attribute to set the switch ID (platform specific info)";
        } // END of switch-id definition.

    } // END of pmirror-destination-erspan-config definition.
    grouping pmirror-erspan-destination-list-top {
        description
            "Port mirror erspan destination list top level configuration";
        container erspan-destinations {
            description
                "Port mirror erspan destinations";

            list erspan-destination {
                if-feature feature-list:HAVE_ADVANCE_MIRROR;
                key "name";
                description
                    "Port mirror erspan destination";
                leaf name  {
                    type  leafref {
                        path  "../config/name";
                    }
                    description "Sets the ERSPAN destination name";
                } // END of name definition.

                container config {
                    presence "yes";
                    description
                        "Configuration for erspan destination";
                    uses pmirror-destination-erspan-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational state data for port mirror erspan";
                    uses pmirror-destination-erspan-config;
                } // END of state-container definition.
            } // End of erspan-destination-list
        } // END of erspan-destinations-container definition.
    } // END of pmirror-erspan-destination-list-top definition.
    grouping pmirror-destination-erspan-session-config {
        description
            "Port mirror destination erspan configuration";
        leaf name  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "Configure ERSPAN destination name";
        } // END of name definition.

    } // END of pmirror-destination-erspan-session-config definition.
    grouping pmirror-destination-erspan-top {
        description
            "Port mirror destination erspan top level configuration";
        container erspan {
            // when " ../../config/type='erspan-sender' ";
            description
                "Port mirror destination erspan configuration";
            container config {
                description
                    "Configuration for port mirror erspan destination";
                uses pmirror-destination-erspan-session-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational state data for port mirror erspan";
                uses pmirror-destination-erspan-session-config;
            } // END of state-container definition.
        } // END of erspan-container definition.
    } // END of pmirror-destination-erspan-top definition.
    grouping pmirror-destination-top {
        description
            "Port mirror destination top configuration";
        container destination {
            description
                "Port mirror session destination configuration";
            uses pmirror-destination-local-top;
            uses pmirror-destination-remote-top;
            uses pmirror-destination-sniff-top;
            uses pmirror-destination-erspan-top;
        } // END of destination-container definition.
    } // END of pmirror-destination-top definition.
    grouping pmirror-counters {
        description
            "Port mirror counters";
        leaf filter-count  {
            type  yang:counter32;
            description "Port mirror session filter count";
        } // END of filter-count definition.

        leaf tx-source-count  {
            type  yang:counter32;
            description "Port mirror session tx source count";
        } // END of tx-source-count definition.

    } // END of pmirror-counters definition.
    grouping pmirror-config {
        description
            "Port mirror configuration";
        leaf id  {
            type  uint32 {
                 range "1..18"  {
                    description "1..18: Supported range 1 - 18";
                 }
            }
            description "Port mirror session index";
        } // END of id definition.

        leaf type  {
            type  ipi-port-mirror-types:pmirror_sess_type_t;
            mandatory true;
            description "Port mirror session type. The default is local";
        } // END of type definition.

        leaf description  {
            type  cml-data-types:cml_line_t {
                length "1..32";
            }
            description "Use this attribute to add a description to port-mirror session";
        } // END of description definition.

    } // END of pmirror-config definition.
    grouping pmirror-src-vlan {
        description
            "Port mirror configuration";
        leaf source-vlan  {
            type  cml-data-types:cml_range_t;
            description "Use this attribute to add VLAN monitor source";
        } // END of source-vlan definition.

    } // END of pmirror-src-vlan definition.
    grouping pmirror-source-vlan {
        description
            "Port mirror source-vlan top";
        container source-vlans {
            description
                "Port mirror source vlan configurations";
            container config {
                description
                    "Configuration data for port-mirror session";
                uses pmirror-src-vlan;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational state data for port-mirror session";
                uses pmirror-src-vlan;
            } // END of state-container definition.
        } // END of source-vlans-container definition.
    } // END of pmirror-source-vlan definition.
    grouping pmirror-enable {
        description
            "Port mirror configuration";
        leaf enabled  {
            type  empty;
            description "Use this attribute to shut/unshut a port-mirror session";
        } // END of enabled definition.

    } // END of pmirror-enable definition.
    grouping pmirror-enabled-top {
        description
            "Port mirror admin status";
        container session-enabled {
            description
                "Port mirror enable configurations";
            container config {
                description
                    "Configuration data for port-mirror session";
                uses pmirror-enable;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational state data for port-mirror session";
                uses pmirror-enable;
            } // END of state-container definition.
        } // END of session-enabled-container definition.
    } // END of pmirror-enabled-top definition.
    grouping pmirror-top {
        description
            "Port mirror top level configuration";
        container sessions {
            description
                "All port-mirror sessions configuration";

            list session {
                if-feature feature-list:HAVE_ADVANCE_MIRROR;
                key "id";
                description
                    "port-mirror session list";
                leaf id  {
                    type  leafref {
                        path  "../config/id";
                    }
                    description "Port mirror session index";
                } // END of id definition.

                container config {
                    description
                        "Configuration data for port-mirror session";
                    uses pmirror-config;
                } // END of config-container definition.
                container state {
                    config false;
                    description
                        "Operational state data for port-mirror session";
                    container counters {
                        config false;
                        description
                            "port-mirror session counters";
                        uses pmirror-counters;
                    } // END of counters-container definition.
                    uses pmirror-config;
                } // END of state-container definition.
                uses pmirror-destination-top;
                uses pmirror-src-itf-top;
                uses pmirror-filters-top;
                uses pmirror-source-vlan;
                uses pmirror-enabled-top;
            } // End of session-list
        } // END of sessions-container definition.
    } // END of pmirror-top definition.
    grouping pmirror-global-config {
        description
            "Port mirror global configuration";
        leaf sniff-packet-truncate-disable  {
            if-feature feature-list:HAVE_ADVANCE_MIRROR;
            if-feature feature-list:HAVE_SNIFF_INTF;
            if-feature feature-list:HAVE_XGS5;
            if-feature feature-list:NOT_HAVE_DUNE;
            type  empty;
            description "Use this attribute to globally enable or disable truncation of sniffed
                        packets";
        } // END of sniff-packet-truncate-disable definition.

    } // END of pmirror-global-config definition.
    grouping pmirror-global-top {
        description
            "Top-level grouping for port mirror global configuration";
        container global {
            description
                "All global configurations";
            container config {
                description
                    "Configuration data for port mirror global";
                uses pmirror-global-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Operational state data for port-mirror global";
                uses pmirror-global-config;
            } // END of state-container definition.
        } // END of global-container definition.
    } // END of pmirror-global-top definition.

    grouping  port-mirror-grouping {
    description
        "Container for all port-mirror configuration";
    container port-mirror {
        if-feature feature-list:HAVE_L2;
        description
            "Container for all port-mirror configuration";
        uses pmirror-top;
        uses pmirror-interface-top;
        uses pmirror-erspan-destination-list-top;
        uses pmirror-global-top;
    } // END of port-mirror-container definition.
    } // END of port-mirror-grouping definition.

    uses port-mirror-grouping;

}