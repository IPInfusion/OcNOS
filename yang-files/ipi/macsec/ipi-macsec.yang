        } // END of rx-sa-programming-state definition.

    } // END of sessions-receive-sa-state definition.
    grouping sessions-transmit-sa-state {
        description
            "Connectivity Association Secure Association state parameters";
        leaf tx-sa-identifier  {
            type  uint32;
            description "Association number";
        } // END of tx-sa-identifier definition.

        leaf tx-secure-channel-identifier  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "Secure channel identifier (SCI)";
        } // END of tx-secure-channel-identifier definition.

        leaf tx-sa-programming-state  {
            type  ipi-macsec-types:macsec_sa_programming_state_t;
            description "Indicates the programming state of the Security Association";
        } // END of tx-sa-programming-state definition.

    } // END of sessions-transmit-sa-state definition.
    grouping sessions-receive-sa-top {
        description
            "MACsec sessions direction SA Top level grouping";
        container receive-secure-associations {
            config false;
            description
                "MACsec sessions secure associations";

            list receive-secure-association {
                key "rx-sa-identifier";
                config false;
                description
                    "MACsec sessions secure association list";
                leaf rx-sa-identifier  {
                    type  leafref {
                        path  "../state/rx-sa-identifier";
                    }
                    description "Association number";
                } // END of rx-sa-identifier definition.

                container state {
                    config false;
                    description
                        "State parameters of secure association";
                    uses sessions-receive-sa-state;
                } // END of state-container definition.
            } // End of receive-secure-association-list
        } // END of receive-secure-associations-container definition.
    } // END of sessions-receive-sa-top definition.
    grouping sessions-transmit-sa-top {
        description
            "MACsec sessions direction SA Top level grouping";
        container transmit-secure-associations {
            config false;
            description
                "MACsec sessions secure associations";

            list transmit-secure-association {
                key "tx-sa-identifier";
                config false;
                description
                    "MACsec sessions secure association list";
                leaf tx-sa-identifier  {
                    type  leafref {
                        path  "../state/tx-sa-identifier";
                    }
                    description "Association number";
                } // END of tx-sa-identifier definition.

                container state {
                    config false;
                    description
                        "State parameters of secure association";
                    uses sessions-transmit-sa-state;
                } // END of state-container definition.
            } // End of transmit-secure-association-list
        } // END of transmit-secure-associations-container definition.
    } // END of sessions-transmit-sa-top definition.
    grouping sessions-receive-state {
        description
            "Operational state data";
        leaf rx-identifier  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "Session identifier";
        } // END of rx-identifier definition.

        leaf rx-session-state  {
            type  ipi-macsec-types:macsec_ca_session_state_t;
            description "The state of Connectivity Association state machine";
        } // END of rx-session-state definition.

        leaf rx-inactive-error-reason  {
            type  ipi-macsec-types:macsec_ca_error_reason_t;
            description "The error reason when the session is inactive";
        } // END of rx-inactive-error-reason definition.

    } // END of sessions-receive-state definition.
    grouping sessions-transmit-state {
        description
            "Operational state data";
        leaf tx-identifier  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "Session identifier";
        } // END of tx-identifier definition.

        leaf tx-session-state  {
            type  ipi-macsec-types:macsec_ca_session_state_t;
            description "The state of Connectivity Association state machine";
        } // END of tx-session-state definition.

        leaf tx-inactive-error-reason  {
            type  ipi-macsec-types:macsec_ca_error_reason_t;
            description "The error reason when the session is inactive";
        } // END of tx-inactive-error-reason definition.

    } // END of sessions-transmit-state definition.
    grouping sessions-receive-top {
        description
            "MACsec sessions receive direction Top level grouping";
        container receive-direction {
            config false;
            description
                "MACsec sessions receive direction";
            container state {
                config false;
                description
                    "State parameters of SecY KAY connection";
                uses sessions-receive-state;
            } // END of state-container definition.
            uses sessions-receive-sa-top;
        } // END of receive-direction-container definition.
    } // END of sessions-receive-top definition.
    grouping sessions-transmit-top {
        description
            "MACsec sessions transmit direction state Top level grouping";
        container transmit-direction {
            config false;
            description
                "MACsec sessions transmit direction";
            container state {
                config false;
                description
                    "State parameters of SecY KAY connection";
                uses sessions-transmit-state;
            } // END of state-container definition.
            uses sessions-transmit-sa-top;
        } // END of transmit-direction-container definition.
    } // END of sessions-transmit-top definition.
    grouping sessions-secy-kay-connection-state {
        description
            "Operational state data";
        leaf kay-connection-status  {
            type  ipi-macsec-types:macsec_kay_connection_status_t;
            description "MACsec KAY connection status, indicating whether it is operational or
                        not";
        } // END of kay-connection-status definition.

        leaf secy-server-host  {
            type  cml-data-types:cml_hostname_t;
            description "Server bound host";
        } // END of secy-server-host definition.

        leaf secy-server-port  {
            type  ipi-macsec-types:macsec_port_number_t;
            description "Server bound port";
        } // END of secy-server-port definition.

        leaf secy-server-listen  {
            type  boolean;
            description "Indicated whether the server is listening or not for connections";
        } // END of secy-server-listen definition.

        leaf kay-client-host  {
            type  cml-data-types:cml_hostname_t;
            description "Client connected from host";
        } // END of kay-client-host definition.

        leaf kay-client-port  {
            type  ipi-macsec-types:macsec_port_number_t;
            description "Client connected from port";
        } // END of kay-client-port definition.

        leaf kay-client-accept  {
            type  boolean;
            description "Indicates whether kay-client connection accepted or not";
        } // END of kay-client-accept definition.

    } // END of sessions-secy-kay-connection-state definition.
    grouping sessions-secy-kay-connection-top {
        description
            "MACsec sessions SecY KAY connection state Top level grouping";
        container secy-kay-connection {
            config false;
            description
                "MACsec sessions SecY KAY connection";
            container state {
                config false;
                description
                    "State parameters of SecY KAY connection";
                uses sessions-secy-kay-connection-state;
            } // END of state-container definition.
        } // END of secy-kay-connection-container definition.
    } // END of sessions-secy-kay-connection-top definition.
    grouping sessions-state {
        description
            "Operational state data for macsec-sessions";
        leaf session-interface-name  {
            type  string {
                length "1..49";
                pattern "[^?' =,>|]+";
            }
            description "MACsec session interface name";
        } // END of session-interface-name definition.

        leaf session-ca-name  {
            type  string {
                length "1..127";
                pattern "[^?' =,>|]+";
            }
            description "MACsec session CA name";
        } // END of session-ca-name definition.

        leaf association-state  {
            type  ipi-macsec-types:macsec_ca_interface_association_state_t;
            description "Indicates whether the CA is associate or not to interface. This
                        attribute value changes when the associated interface flaps";
        } // END of association-state definition.

        leaf traffic-status  {
            type  ipi-macsec-types:macsec_ca_traffic_status_t;
            description "This attribute indicated if the traffic in protected or not";
        } // END of traffic-status definition.

        leaf member-identifier  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "This attribute indicates the member identifier (MI), that is a unique
                        identifier used to distinguish each participating network node within
                        a Connectivity Association (CA) domain";
        } // END of member-identifier definition.

        leaf cak-name  {
            type  string {
                length "1..1965";
                pattern "[^?' =,>|]+";
            }
            description "This attribute indicates the Connectivity Association Key Name (CKN)";
        } // END of cak-name definition.

        leaf rekey-interval  {
            type  uint32;
            description "This attribute indicates the interval that is configured in MKA for
                        the rekeying of SAKs";
        } // END of rekey-interval definition.

        leaf key-server-priority  {
            type  uint8;
            description "This attribute specifies the MKA server election priority number";
        } // END of key-server-priority definition.

        leaf key-server  {
            type  boolean;
            description "This attribute indicates whether the node is the key server or not";
        } // END of key-server definition.

        leaf latest-sak-an  {
            type  uint8;
            description "This attribute indicates the current SAK association number";
        } // END of latest-sak-an definition.

        leaf previous-sak-an  {
            type  uint8;
            description "This attribute indicates the previous SAK association number";
        } // END of previous-sak-an definition.

        leaf security-suite  {
            type  ipi-macsec-types:macsec_cipher_suite_t;
            description "This attribute specifies the security-suite that was chosen by
                        key-server to encrypt SAKs";
        } // END of security-suite definition.

    } // END of sessions-state definition.
    grouping sessions-top {
        description
            "MACsec sessions state Top level grouping";
        container sessions {
            config false;
            description
                "MACsec sessions";

            list session {
                key "session-interface-name session-ca-name";
                config false;
                description
                    "MACsec sessions list";
                leaf session-interface-name  {
                    type  leafref {
                        path  "../state/session-interface-name";
                    }
                    description "MACsec session interface name";
                } // END of session-interface-name definition.

                leaf session-ca-name  {
                    type  leafref {
                        path  "../state/session-ca-name";
                    }
                    description "MACsec session CA name";
                } // END of session-ca-name definition.

                container state {
                    config false;
                    description
                        "State parameters of connectivity association";
                    uses sessions-state;
                } // END of state-container definition.
                uses sessions-secy-kay-connection-top;
                uses sessions-receive-top;
                uses sessions-transmit-top;
                uses sessions-mka-statistics-top;
                uses sessions-hw-events-statistics-top;
            } // End of session-list
        } // END of sessions-container definition.
    } // END of sessions-top definition.
    grouping macsec-debug-config {
        description
            "Grouping for debug configuration for Macsec";
        leaf options  {
            type  ipi-macsec-types:macsec_mka_debug_t;
            description "Use this attribute to enable macsec debug";
        } // END of options definition.

    } // END of macsec-debug-config definition.
    grouping macsec-debug-top {
        description
            "Grouping for debug top";
        container debug {
            description
                "Debug Flags";
            container config {
                description
                    "Debug flags for configuration";
                uses macsec-debug-config;
            } // END of config-container definition.
            container state {
                config false;
                description
                    "Debug flags state information";
                uses macsec-debug-config;
            } // END of state-container definition.
        } // END of debug-container definition.
    } // END of macsec-debug-top definition.

    grouping  macsec-grouping {
    description
        "Top level container for macsec configurations";
    container macsec {
        if-feature feature-list:HAVE_MACSEC;
        description
            "Top level container for macsec configurations";
        uses key-management-entity-top;
        uses quantum-key-distribution-top;
        uses security-entity-top;
        uses connectivity-associations-top;
        uses sessions-top;
        uses macsec-debug-top;
        uses interfaces-grouping;
    } // END of macsec-container definition.
    } // END of macsec-grouping definition.

    uses macsec-grouping;

    rpc macsec-clear-statistics-interface {
        if-feature feature-list:HAVE_MACSEC;
        description "Clears MACsec statistics from interface";
        input  {
            leaf name  {
                type string;
                mandatory true;
                description "Specify the interface name for which statistics should be cleared";
            }
        }
    }

    rpc macsec-clear-sessions-interface-statistics {
        if-feature feature-list:HAVE_MACSEC;
        description "Clears MACsec sessions statistics from interface";
        input  {
            leaf name  {
                type string;
                mandatory true;
                description "Specify the interface name for which statistics should be cleared";
            }
        }
    }

    rpc macsec-clear-secy-statistics {
        if-feature feature-list:HAVE_MACSEC;
        description "Clears MACsec secy statistics";
    }

}