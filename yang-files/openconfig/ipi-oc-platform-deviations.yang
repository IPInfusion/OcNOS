module ipi-oc-platform-deviations {
  namespace "http://www.ipinfusion.com/yang/ocnos/ipi-oc-platform-deviations";
  prefix "ipi-oc-platform-deviations";

  import openconfig-platform {
      prefix oc-platform;
  }

  import openconfig-platform-cpu {
      prefix oc-cpu;
  }

  import openconfig-platform-psu {
      prefix oc-platform-psu;
  }

  import openconfig-platform-port {
      prefix oc-port;
  }

  import openconfig-platform-linecard {
      prefix oc-linecard;
  }

  import openconfig-terminal-device {
    prefix oc-opt-term;
  }

  import openconfig-transport-line-common {
    prefix oc-line-com;
  }

  import openconfig-alarms {
    prefix oc-alarms;
  }

  import openconfig-platform-ext {
    prefix oc-platform-ext;
  }

  revision "2025-06-16" {
    description "Adjustment to the description of some pre-FEC BER deviations";
  }

  revision "2025-05-15" {
    description "Adjust OpenConfig translation for QSFP-DD optical-channel chromatic-dispersion attributes";
  }

  revision "2024-07-01" {
    description "Added new deviations after upgrading to the OpenConfig v4.2.0";
  }

  revision "2024-05-24" {
      description
        "Added a new deviation to oc-cpu types avg and instant";
  }

  revision "2024-04-24" {
    description "Reverted the previous deviation for not-supported paths";
  }

  revision "2024-04-10" {
    description "Add deviations for not-supported paths";
  }

  revision "2024-04-09" {
    description "Add deviations to not support leaf subcomponents/subcomponent/config and change subcomponent to config false";
  }

  revision "2024-02-23" {
    description "Updated deviations to support leaf cpu/utilization/state/interval";
  }

  revision "2024-01-25" {
    description "Change input-voltage type and move transceiver deviations to
                ipi-oc-platform-transceiver-deviations.yang";
  }

  revision "2024-01-16" {
    description "Updated deviations to support port-breakout";
  }

  revision "2023-11-27" {
    description "Updated deviations to support OpenZR+";
  }

  revision "2023-04-24" {
    description "Add deviations for not-supported paths";
  }

  revision "2022-07-01" {
    description "Added new deviations to non supported trees in component/cpu/config, component/fan/config,
                 component/transceiver/config, component/power-supply/config, subcomponents/subcomponent/config
                 and port/config";
  }

  revision "2022-04-26" {
    description "Added deviation to replace default value for oc-linecard:power-admin-state";
  }

  revision "2022-01-19" {
    description "Added new deviations for not supported trees";
  }

  revision "2021-05-07" {
      description
        "Added support to component parent, then not supported was removed.
         Added more deviations for transceiver attributes.";
  }

  revision "2021-01-29" {
      description
        "First release: add a type deviation for mfg-date";
  }

  deviation /oc-platform:components/oc-platform:component/oc-linecard:linecard/oc-linecard:config/oc-linecard:power-admin-state {
      deviate replace {
        default "POWER_DISABLED";
      }
  }

  deviation /oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state/oc-platform-psu:output-voltage {
      deviate replace {
          type decimal64 {
              fraction-digits 2;
          }
      }
  }

  deviation /oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state/oc-platform-psu:capacity {
      deviate replace {
          type decimal64 {
              fraction-digits 2;
          }
      }
  }

  deviation /oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state/oc-platform-psu:input-current {
      deviate replace {
          type decimal64 {
              fraction-digits 2;
          }
      }
  }

  deviation /oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state/oc-platform-psu:input-voltage {
      deviate replace {
          type decimal64 {
              fraction-digits 2;
          }
      }
  }

  deviation /oc-platform:components/oc-platform:component/oc-platform:power-supply/oc-platform:state/oc-platform-psu:output-current {
      deviate replace {
          type decimal64 {
              fraction-digits 2;
